*{box-sizing:border-box}body{margin:0;background:#f7f5fb;color:#292631;font-family:-apple-system,BlinkMacSystemFont,"Noto Sans JP","Noto Sans KR",sans-serif}main{max-width:980px;margin:auto;padding:36px 20px 70px}.eyebrow{font-size:11px;letter-spacing:2px;opacity:.5}h1{font-size:38px;margin:8px 0 24px}h1 span{font-size:17px;letter-spacing:2px}.banner{padding:25px;border-radius:22px;background:linear-gradient(135deg,#fff,#ece7fa);margin-bottom:16px}.banner b{font-size:11px;background:#292631;color:#fff;padding:6px 10px;border-radius:20px}.banner h2{font-size:28px;margin:12px 0}.actions{display:flex;gap:10px;flex-wrap:wrap}.actions button{border:0;border-radius:12px;padding:13px 20px;font-weight:700;cursor:pointer}.primary{background:#292631!important;color:white}.stats{margin:18px 0;color:#777;font-size:13px}#results{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;align-items:stretch}.empty{grid-column:1/-1;text-align:center;padding:70px;color:#aaa}.card{border:0;background:#fff;border-radius:16px;padding:0;overflow:hidden;text-align:left;cursor:pointer;box-shadow:0 5px 18px #0001;display:flex;flex-direction:column;min-width:0;height:100%}.card img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block;flex:none}.info{padding:12px;display:flex;flex-direction:column;flex:1}.stars{letter-spacing:1px}.title{font-weight:800;margin-top:5px;font-size:14px}.actor{font-size:11px;color:#777;margin-top:auto;padding-top:5px}.modal{position:fixed;inset:0;background:#000b;z-index:50;display:flex;align-items:center;justify-content:center;padding:32px;overflow:auto}.modal[hidden]{display:none}.dialog{position:relative;display:inline-block;width:auto;height:auto;max-width:92vw;max-height:88vh;background:transparent;color:white;overflow:visible;line-height:0}.dialog>img{display:block;width:auto;height:auto;max-width:92vw;max-height:88vh;object-fit:contain;border-radius:12px;background:transparent}.dialog #close{position:absolute;right:-14px;top:-14px;width:40px;height:40px;border:0;border-radius:50%;font-size:25px;line-height:40px;background:#222e;color:#fff;cursor:pointer;z-index:4;box-shadow:0 2px 10px #0005}.meta{position:absolute;left:0;right:0;bottom:0;padding:48px 16px 14px 68px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;background:linear-gradient(transparent,#000b);pointer-events:none;line-height:1.35;border-radius:0 0 12px 12px}.meta span{opacity:.8;font-size:13px}.awaken-arrow{position:absolute;left:14px;bottom:12px;width:44px;height:44px;border:1px solid #ffffff88;border-radius:50%;background:#111b;color:#fff;display:grid;place-items:center;cursor:pointer;z-index:5;backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);padding:8px;line-height:1}.awaken-arrow svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;display:block}.awaken-arrow[hidden]{display:none}.awaken-arrow:active{transform:rotate(25deg)}@media(max-width:900px){#results{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:600px){main{padding-left:14px;padding-right:14px}#results{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.card img{aspect-ratio:16/9}.title{font-size:12px}.modal{padding:18px}.dialog,.dialog>img{max-width:94vw;max-height:82vh}.dialog #close{right:-8px;top:-10px}.meta{padding:44px 12px 10px 62px}.awaken-arrow{left:10px;bottom:8px;width:42px;height:42px}}
/* v8: mobile-first responsive tuning */
@media (max-width: 600px){
  body{background:#f8f7fb}
  main{width:100%;max-width:none;padding:20px 12px 42px}
  .eyebrow{font-size:9px;letter-spacing:1.4px;margin:0 0 4px}
  h1{font-size:27px;line-height:1.05;margin:6px 0 16px}
  h1 span{display:block;font-size:11px;letter-spacing:1.6px;margin-top:5px}
  .banner{padding:17px 16px;border-radius:18px;margin-bottom:12px}
  .banner b{font-size:9px;padding:5px 8px}
  .banner h2{font-size:20px;line-height:1.2;margin:10px 0 8px}
  .banner p{font-size:13px;margin:7px 0}
  .banner small{font-size:10px}
  .actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .actions button{min-height:46px;padding:11px 8px;border-radius:12px;font-size:13px}
  .actions #clear{grid-column:1/-1;min-height:40px}
  .stats{margin:13px 2px 14px;font-size:11px;line-height:1.7;white-space:normal}
  #results{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;align-items:stretch}
  .empty{padding:48px 8px;font-size:13px}
  .card{border-radius:12px;box-shadow:0 3px 12px #0000000d}
  .card img{aspect-ratio:16/9;object-fit:cover}
  .info{padding:9px 9px 10px;min-height:86px}
  .stars{font-size:12px;line-height:1}
  .title{font-size:11.5px;line-height:1.35;margin-top:6px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:31px}
  .actor{font-size:9.5px;padding-top:5px}
  .modal{padding:16px 12px;background:#000c}
  .dialog{max-width:calc(100vw - 24px);max-height:84vh}
  .dialog>img{max-width:calc(100vw - 24px);max-height:84vh;border-radius:10px}
  .dialog #close{right:7px;top:7px;width:36px;height:36px;line-height:34px;font-size:23px;background:#111a;box-shadow:none}
  .meta{padding:42px 12px 10px 58px;border-radius:0 0 10px 10px;gap:6px;font-size:12px}
  .meta span{font-size:10px}
  .awaken-arrow{left:9px;bottom:8px;width:40px;height:40px;padding:7px;background:#111a}
}

@media (max-width: 360px){
  main{padding-left:9px;padding-right:9px}
  #results{gap:7px}
  .info{padding:8px;min-height:82px}
  .title{font-size:10.5px}
  .actions button{font-size:12px}
}

/* Gacha selector */

.gacha-tabs{
  display:flex;
  gap:10px;
  margin-bottom:14px;
}

.gacha-tab{
  border:1px solid #ddd8e8;
  background:#fff;
  color:#777;
  padding:10px 17px;
  border-radius:999px;
  font-weight:800;
  cursor:pointer;
  transition:.18s;
}

.gacha-tab:hover{
  transform:translateY(-1px);
}

.gacha-tab.active{
  background:#292631;
  color:#fff;
  border-color:#292631;
}


/* =========================================
   YUMESTE DESIGN UPDATE
   ========================================= */

@font-face{
  font-family:"YumesteUI";
  src:url("RoNOWStd-GBs.otf") format("opentype");
  font-display:swap;
}

html,
body,
button{
  font-family:"YumesteUI",
              "Noto Sans JP",
              "Hiragino Sans",
              sans-serif;
}

body{
  background:#fff;
  color:#25252b;
}

main{
  max-width:1100px;
  padding-top:46px;
}

.eyebrow{
  margin:0 0 8px;
  font-size:12px;
  letter-spacing:1.4px;
  color:#999;
}

h1{
  margin:0 0 32px;
  font-size:38px;
  font-weight:700;
  letter-spacing:.03em;
}


/* ---------- GACHA LOGOS ---------- */

.gacha-tabs{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
  margin:0 0 22px;
}

.gacha-tab{
  position:relative;
  height:105px;
  padding:16px 28px;

  display:flex;
  align-items:center;
  justify-content:center;

  background:#fff;
  border:1px solid #e7e7eb;
  border-radius:8px;

  cursor:pointer;

  transition:
    transform .18s ease,
    border-color .18s ease,
    box-shadow .18s ease,
    background .18s ease;
}

.gacha-tab img{
  display:block;
  max-width:88%;
  max-height:70px;
  width:auto;
  height:auto;
  object-fit:contain;
}

.gacha-tab:hover{
  transform:translateY(-2px);
  border-color:#91e5dd;
  background:#fbffff;
  box-shadow:0 8px 25px rgba(41,196,184,.10);
}

.gacha-tab.active{
  border-color:#48d7ca;
  box-shadow:
    0 0 0 2px rgba(72,215,202,.12),
    0 7px 22px rgba(72,215,202,.10);
}

.gacha-tab.active::after{
  content:"";
  position:absolute;
  left:18px;
  right:18px;
  bottom:-1px;
  height:3px;
  border-radius:3px 3px 0 0;
  background:#48d7ca;
}


/* ---------- SELECTED GACHA ---------- */

.banner{
  position:relative;
  overflow:hidden;

  padding:27px 30px;
  margin-bottom:20px;

  border:1px solid #e8ecee;
  border-radius:8px;

  background:
    linear-gradient(115deg,#fff 0%,#fbffff 55%,#effcfb 100%);
}

.banner::after{
  content:"";
  position:absolute;
  width:170px;
  height:170px;
  right:-55px;
  top:-80px;
  border-radius:50%;
  background:rgba(75,218,205,.08);
}

.banner.collab{
  background:
    linear-gradient(115deg,#fff 0%,#fffafd 55%,#f2fbff 100%);
}

.banner b{
  display:inline-block;

  padding:0;
  border-radius:0;

  background:none;
  color:#37bdb2;

  font-size:11px;
  letter-spacing:2px;
}

.banner h2{
  position:relative;
  z-index:1;

  margin:10px 0 0;
  font-size:23px;
  font-weight:700;
  letter-spacing:.02em;
}


/* ---------- PULL BUTTONS ---------- */

.actions{
  display:flex;
  align-items:stretch;
  gap:10px;
}

.actions button{
  min-width:150px;
  min-height:58px;

  padding:9px 18px;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  border:1px solid #dfe4e6;
  border-radius:7px;

  background:#fff !important;
  color:#292931 !important;

  font-family:inherit;
  font-weight:700;

  transition:
    background .16s ease,
    color .16s ease,
    border-color .16s ease,
    transform .16s ease,
    box-shadow .16s ease;
}

.actions button:hover{
  background:#43d3c7 !important;
  color:#fff !important;
  border-color:#43d3c7;
  transform:translateY(-1px);
  box-shadow:0 5px 16px rgba(52,194,183,.18);
}

.pull-label{
  font-size:15px;
  line-height:1.2;
}

.pull-cost{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:4px;

  margin-top:4px;

  font-size:11px;
  line-height:1;
  opacity:.72;
}

.pull-cost img{
  width:17px;
  height:17px;
  object-fit:contain;
  border-radius:0;
}


/* 결과 초기화 버튼에는 재화 영역 없음 */

#clear{
  min-width:130px;
}


/* ---------- STATS ---------- */

.stats{
  margin:20px 0;
  padding-bottom:12px;

  border-bottom:1px solid #eeeeef;

  color:#85858d;
  font-size:13px;
}

.stats b{
  color:#292931;
}


/* ---------- EMPTY ---------- */

.empty{
  color:#aaaeb2;
  letter-spacing:.04em;
}


/* ==================================================
   YUMESTE UI - GAME STYLE REVISION
   ================================================== */

/* 전체 글자 */
body,
button{
  font-family:"YumesteUI",
              "Hiragino Kaku Gothic ProN",
              "Yu Gothic",
              sans-serif;
  font-weight:700;
}

body{
  background:#fff;
  color:#4c4b55;
}

main{
  max-width:1080px;
}


/* ----------------------------------
   HEADER
---------------------------------- */

.eyebrow{
  font-size:11px;
  font-weight:700;
  letter-spacing:.07em;
  color:#aaaab1;
}

h1{
  color:#4b4a53;
  font-size:34px;
  font-weight:800;
  letter-spacing:.02em;
}


/* ----------------------------------
   SMALL GACHA SELECTOR
---------------------------------- */

.gacha-tabs{
  display:flex;
  grid-template-columns:none;

  align-items:center;
  justify-content:flex-start;

  gap:10px;
  margin:0 0 16px;
}


/* 기존 큰 카드 스타일 제거 */
.gacha-tab{
  width:150px;
  height:52px;
  min-width:0;

  padding:6px 12px;

  display:flex;
  align-items:center;
  justify-content:center;

  background:#f7f7f8 !important;

  border:2px solid #8d8d96 !important;
  border-radius:13px;

  box-shadow:
    inset 0 0 0 2px #fff,
    0 2px 3px rgba(0,0,0,.12);

  transform:none !important;

  overflow:hidden;
}


/* 로고 크기 */
.gacha-tab img{
  display:block;

  width:auto;
  height:auto;

  max-width:112px;
  max-height:34px;

  object-fit:contain;

  filter:none;
}


/* 기존 밑줄 활성화 완전히 제거 */
.gacha-tab::after,
.gacha-tab.active::after{
  display:none !important;
  content:none !important;
}


/* 마우스를 올렸을 때 */
.gacha-tab:hover{
  background:#e9fffc !important;
  border-color:#50cfc5 !important;

  box-shadow:
    inset 0 0 0 2px #fff,
    0 3px 7px rgba(56,190,181,.20);
}


/* 선택된 가챠:
   1回引く 버튼과 같은 방식 */
.gacha-tab.active{
  background:#4fd2c7 !important;
  border-color:#39aaa2 !important;

  box-shadow:
    inset 0 0 0 2px rgba(255,255,255,.85),
    0 3px 7px rgba(56,190,181,.20);
}


/* 선택되어도 로고 자체는 그대로 */
.gacha-tab.active img{
  opacity:1;
}


/* ----------------------------------
   SELECTED GACHA DESCRIPTION
---------------------------------- */

.banner{
  min-height:auto;

  margin:0 0 18px;
  padding:18px 22px;

  background:#f8f9fa;

  border:2px solid #dedee2;
  border-radius:13px;

  box-shadow:
    inset 0 0 0 2px #fff,
    0 2px 4px rgba(0,0,0,.08);
}


/* 웹사이트 느낌의 장식 제거 */
.banner::after{
  display:none;
}

.banner.collab{
  background:#f8f9fa;
}


/* ALL ACTOR / COLLABORATION */
.banner b{
  display:inline-block;

  padding:3px 12px;

  background:#ffad28;
  color:#fff;

  border-radius:999px;

  font-size:11px;
  font-weight:800;
  letter-spacing:.03em;

  text-shadow:
    0 1px 1px rgba(0,0,0,.12);
}


/* 메인 설명 */
.banner h2{
  margin:10px 0 0;

  color:#55545d;

  font-size:20px;
  font-weight:800;
  letter-spacing:.015em;

  text-shadow:
    0 1px 0 #fff;
}


/* ----------------------------------
   PULL BUTTONS
---------------------------------- */

.actions{
  gap:12px;
}


/* 유메스테 원본처럼:
   회색 외곽선 + 밝은 면 + 둥근 모서리 */
.actions button{
  min-width:170px;
  min-height:62px;

  padding:8px 18px;

  background:
    linear-gradient(#fff,#eeeeF1) !important;

  color:#55545d !important;

  border:2px solid #85858d !important;
  border-radius:14px;

  box-shadow:
    inset 0 0 0 2px rgba(255,255,255,.95),
    0 3px 4px rgba(0,0,0,.14);

  text-shadow:
    0 1px 0 #fff;

  transform:none;
}


/* 10회 버튼의 기존 primary 색 강제 제거 */
.actions .primary{
  background:
    linear-gradient(#fff,#eeeeF1) !important;

  color:#55545d !important;
}


/* 커서를 올린 경우에만 포인트색 */
.actions button:hover,
.actions .primary:hover{
  background:
    linear-gradient(#65ded5,#3fc8bd) !important;

  border-color:#329f98 !important;

  color:#fff !important;

  text-shadow:
    0 1px 2px rgba(0,0,0,.18);

  transform:translateY(-1px);

  box-shadow:
    inset 0 0 0 2px rgba(255,255,255,.75),
    0 4px 7px rgba(0,0,0,.14);
}


/* 뽑기 글씨 */
.pull-label{
  font-size:17px;
  font-weight:800;
  line-height:1.1;
}


/* 재화 */
.pull-cost{
  margin-top:5px;

  font-size:13px;
  font-weight:800;

  color:inherit;
  opacity:1;
}


/* 재화 이미지 */
.pull-cost img{
  width:19px;
  height:19px;

  object-fit:contain;
}


/* 결과 초기화는 살짝 작게 */
#clear{
  min-width:145px;
  font-size:14px;
}


/* ----------------------------------
   STATS
---------------------------------- */

.stats{
  margin:20px 0 17px;

  color:#8b8a91;

  font-size:13px;
  font-weight:700;

  border-bottom:1px solid #e7e7e9;
}

.stats b{
  color:#55545d;
  font-weight:800;
}


/* ----------------------------------
   RESULT CARDS
---------------------------------- */

.card{
  border:2px solid #dedee2;

  border-radius:12px;

  box-shadow:
    0 3px 8px rgba(0,0,0,.10);

  background:#fff;
}

.card:hover{
  transform:translateY(-2px);

  border-color:#6bd7ce;

  box-shadow:
    0 6px 14px rgba(0,0,0,.13);
}

.card .title{
  color:#4f4e57;

  font-weight:800;
}

.card .actor{
  color:#96959c;

  font-weight:700;
}


/* 별 등급 */
.card .stars,
#modalStars{
  color:#ff9f24;

  font-weight:800;

  text-shadow:
    0 1px 1px rgba(0,0,0,.08);
}


/* ----------------------------------
   EMPTY MESSAGE
---------------------------------- */

.empty{
  color:#aaa9b0;

  font-size:14px;
  font-weight:700;
}


/* ========================================
   START SCREEN
   ======================================== */

.start-screen{
  position:fixed;
  inset:0;
  z-index:9999;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  background:#fff;

  opacity:1;
  transition:
    opacity .35s ease,
    visibility .35s ease;
}

.start-screen[hidden]{
  display:none;
}

.start-button{
  width:150px;
  height:150px;

  display:flex;
  align-items:center;
  justify-content:center;

  padding:0;

  border:0;
  outline:0;

  background:transparent;

  cursor:pointer;

  appearance:none;
  -webkit-appearance:none;

  transition:transform .16s ease;
}

.start-button img{
  display:block;

  width:125px;
  height:125px;

  object-fit:contain;

  user-select:none;
  -webkit-user-drag:none;
}

.start-button:hover{
  transform:scale(1.04);
}

.start-button:active{
  transform:scale(.97);
}

.start-hint{
  margin-top:15px;

  font-family:"YumesteUI",
              "Hiragino Kaku Gothic ProN",
              sans-serif;

  font-size:11px;
  font-weight:700;

  letter-spacing:.18em;

  color:#c5c5ca;

  transition:
    color .16s ease,
    transform .16s ease;
}

.start-button:hover + .start-hint{
  color:#8f8f96;
  transform:translateY(2px);
}

.start-screen.start-leave{
  opacity:0;
  visibility:hidden;
}

/* 카드 정보: 배우명을 메인으로 강조 */

.card .info{
  padding:12px 13px 13px;
}

.card .stars{
  margin-bottom:7px;
}

.card .actor{
  margin:0;
  padding:0;

  color:#4d4c55;

  font-size:16px;
  font-weight:800;
  line-height:1.25;
}

.card .title{
  margin-top:5px;

  color:#8c8b93;

  font-size:12px;
  font-weight:700;
  line-height:1.4;

  /* 긴 카드명은 최대 두 줄 */
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
}

/* ===== ユメステ風 テキストエフェクト ===== */

/* 가챠 버튼의 1回引く / 10回引く */
.pull-label {
  font-weight: 900;
  letter-spacing: 0.02em;

  /* 밝은 테두리 + 아래쪽 입체 그림자 */
  -webkit-text-stroke: 1px rgba(255,255,255,0.95);
  paint-order: stroke fill;

  text-shadow:
    0 1px 0 rgba(255,255,255,0.95),
    0 2px 0 rgba(80,78,88,0.18),
    0 3px 5px rgba(60,58,68,0.14);
}


/* 배너 메인 문구 */
.banner h2 {
  font-weight: 900;
  letter-spacing: 0.015em;

  -webkit-text-stroke: 1px rgba(255,255,255,0.9);
  paint-order: stroke fill;

  text-shadow:
    0 1px 0 #fff,
    0 2px 0 rgba(80,78,88,0.13),
    0 3px 5px rgba(70,68,78,0.10);
}


/* 상단 메인 제목 */
main > h1 {
  font-weight: 900;
  letter-spacing: 0.015em;

  -webkit-text-stroke: 1px rgba(255,255,255,0.9);
  paint-order: stroke fill;

  text-shadow:
    0 2px 0 rgba(255,255,255,0.9),
    0 3px 0 rgba(75,73,84,0.12),
    0 4px 7px rgba(65,63,74,0.10);
}


/* 통계 숫자 */
.stats b {
  font-weight: 900;
  text-shadow:
    0 1px 0 #fff,
    0 2px 3px rgba(60,58,68,0.12);
}


/* 카드 액터명은 효과를 약하게 */
.card .actor {
  font-weight: 900;
  text-shadow:
    0 1px 0 #fff,
    0 1px 2px rgba(60,58,68,0.10);
}



/* ===== TITLE EASTER EGG ===== */

.title-row {
  display: flex;
  align-items: center;
  gap: 8px;
  position: relative;
}

.title-row > h1 {
  margin-right: 0;
}

/* 전체 이스터에그 영역 */
.easter-egg {
  position: relative;
  display: flex;
  align-items: center;
  height: 54px;
  z-index: 20;
}

/* 분홍 캐릭터: 항상 고정 */
.easter-trigger {
  position: relative;
  z-index: 3;

  width: 48px;
  height: 48px;
  padding: 0;

  border: 0;
  background: transparent;
  cursor: pointer;

  flex: 0 0 48px;

  transition:
    transform .18s ease,
    filter .18s ease;
}

.easter-trigger:hover {
  transform: translateY(-2px) scale(1.04);
  filter: drop-shadow(0 3px 4px rgba(0,0,0,.12));
}

.easter-left {
  display: block;
  width: 48px;
  height: 48px;
  object-fit: contain;
}

/*
  닫혀 있을 때:
  파란 캐릭터를 분홍 캐릭터 뒤에 겹쳐 숨겨둠.
*/
.easter-reveal {
  position: absolute;
  left: 0;
  top: 50%;

  height: 54px;
  width: 48px;

  transform: translateY(-50%);

  pointer-events: none;
}

/* 가운데 연락처 */
.easter-message {
  position: absolute;
  left: 58px;
  top: 50%;

  width: 0;
  padding: 0;

  transform: translateY(-50%);

  opacity: 0;
  overflow: hidden;
  white-space: nowrap;

  font-size: 11px;
  line-height: 1.45;
  color: #55525d;

  transition:
    width .45s cubic-bezier(.22,.8,.25,1),
    opacity .25s ease,
    padding .45s cubic-bezier(.22,.8,.25,1);
}

.easter-message strong,
.easter-message span {
  display: block;
}

.easter-message strong {
  font-size: 11.5px;
  color: #34313b;
  margin-bottom: 2px;
}

.easter-message a {
  color: inherit;
  font-weight: 800;
  text-decoration: none;
}

.easter-message a:hover {
  text-decoration: underline;
}

/* 파란 캐릭터 */
.easter-right {
  position: absolute;
  z-index: 2;

  left: 0;
  top: 3px;

  width: 48px;
  height: 48px;
  object-fit: contain;

  opacity: 0;

  transition:
    transform .52s cubic-bezier(.22,.8,.25,1),
    opacity .18s ease;
}


/* ===== 열렸을 때 ===== */

.easter-egg.open .easter-reveal {
  pointer-events: auto;
}

.easter-egg.open .easter-message {
  width: 330px;
  padding: 5px 8px;

  opacity: 1;
}

.easter-egg.open .easter-right {
  /*
    분홍이는 그대로,
    파란이만 연락처 오른쪽까지 슬라이드
  */
  transform: translateX(405px);
  opacity: 1;
}


/* 작은 화면에서 너무 길어지는 것 방지 */
@media (max-width: 760px) {
  .easter-egg.open .easter-message {
    width: 270px;
    white-space: normal;
  }

  .easter-egg.open .easter-right {
    transform: translateX(345px);
  }
}



/* ===== TITLE ALIGNMENT + HOME ===== */

.title-row {
  display: flex;
  align-items: center;
}

/* h1 자체의 기본 line-height 때문에 어긋나는 것 방지 */
.title-row > h1 {
  display: flex;
  align-items: center;
  margin-top: 0;
  margin-bottom: 0;
  line-height: 1;
}

/* 제목을 버튼처럼 보이지 않게 */
.title-home {
  appearance: none;
  -webkit-appearance: none;

  margin: 0;
  padding: 0;

  border: 0;
  background: transparent;

  color: inherit;
  font: inherit;
  font-weight: inherit;
  letter-spacing: inherit;
  line-height: 1;

  cursor: pointer;

  text-align: left;

  transition:
    opacity .18s ease,
    transform .18s ease;
}

.title-home:hover {
  opacity: .78;
}

.title-home:active {
  transform: translateY(1px);
}


/* 이스터에그를 제목의 정확한 세로 중앙에 */
.easter-egg {
  align-self: center;
  height: 48px;
  display: flex;
  align-items: center;
}

.easter-trigger {
  align-self: center;
}

.easter-left {
  display: block;
  margin: 0;
}

/* 파란 캐릭터도 같은 중앙선 */
.easter-reveal {
  top: 50%;
  height: 48px;
  transform: translateY(-50%);
}

.easter-right {
  top: 0;
}

.easter-message {
  top: 50%;
  transform: translateY(-50%);
}



/* ===== TITLE AREA SPACING FIX ===== */

/* 제목 + 이스터에그와 아래 가챠 로고 사이에 여유 */
.title-row {
  margin-bottom: 28px !important;
}

/* 제목과 이스터에그 자체 간격 */
.title-row {
  gap: 12px !important;
}



/* ===== 10 PULL GUARANTEE ===== */

.ten-pull-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.guarantee-badge {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 7px);
  transform: translateX(-50%);
  z-index: 5;

  padding: 5px 13px 6px;

  background: #e94b55;
  border: 2px solid #fff;
  border-radius: 8px;

  color: #fff;
  font-size: 13px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: .02em;
  white-space: nowrap;

  box-shadow:
    0 1px 0 rgba(70,60,70,.20),
    0 2px 5px rgba(70,60,70,.16);

  text-shadow: 0 1px 1px rgba(100,20,30,.25);

  pointer-events: none;
}

/* 흰색 테두리까지 있는 말풍선 꼬리 */
.guarantee-badge::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 100%;
  transform: translateX(-50%);

  border-left: 7px solid transparent;
  border-right: 7px solid transparent;
  border-top: 7px solid #fff;
}

.guarantee-badge::after {
  content: "";
  position: absolute;
  left: 50%;
  top: calc(100% - 2px);
  transform: translateX(-50%);

  border-left: 5px solid transparent;
  border-right: 5px solid transparent;
  border-top: 5px solid #e94b55;
}



/* ===== SAVE NOTICE ===== */

.save-notice {
  width: 100%;
  max-width: 980px;
  margin: 0 auto 28px;
  padding: 0 20px;

  text-align: center;

  color: #99959f;
  font-size: 11px;
  font-weight: 600;
  line-height: 1.6;
  letter-spacing: .01em;
}

/* ===== GIFT BOX UI ===== */

.gift-toolbar {
  display: flex;
  justify-content: flex-end;
  margin: -4px 0 14px;
}

.gift-box-button {
  position: relative;
  display: flex;
  align-items: center;
  gap: 7px;

  min-height: 42px;
  padding: 7px 14px;

  border: 2px solid #85858d;
  border-radius: 12px;

  background: linear-gradient(#ffffff, #eeeeF1);
  color: #55545d;

  font: inherit;
  font-size: 13px;
  font-weight: 800;

  cursor: pointer;

  box-shadow:
    inset 0 0 0 2px rgba(255,255,255,.95),
    0 2px 4px rgba(0,0,0,.12);
}

.gift-box-button:hover {
  background: linear-gradient(#65ded5, #3fc8bd);
  border-color: #329f98;
  color: white;
}

.gift-icon {
  font-size: 17px;
  line-height: 1;
}

.gift-badge {
  position: absolute;
  top: -9px;
  right: -9px;

  display: grid;
  place-items: center;

  min-width: 22px;
  height: 22px;
  padding: 0 5px;

  border: 2px solid white;
  border-radius: 999px;

  background: #e94b55;
  color: white;

  font-size: 11px;
  font-weight: 900;
  line-height: 1;

  box-shadow: 0 2px 5px rgba(0,0,0,.18);
}


/* ---------- modal ---------- */

.gift-modal {
  position: fixed;
  inset: 0;
  z-index: 10000;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 24px;

  background: rgba(25,25,30,.58);
}

.gift-modal[hidden] {
  display: none;
}

.gift-dialog {
  width: min(620px, calc(100vw - 32px));
  max-height: min(650px, calc(100vh - 48px));

  display: flex;
  flex-direction: column;

  overflow: hidden;

  border: 3px solid #85858d;
  border-radius: 18px;

  background: #f7f7f9;

  box-shadow:
    inset 0 0 0 2px white,
    0 14px 45px rgba(0,0,0,.25);
}


/* ---------- header ---------- */

.gift-header {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;

  min-height: 66px;
  padding: 14px 60px;

  border-bottom: 2px solid #dedee2;

  background: white;
}

.gift-header h2 {
  margin: 0;

  color: #55545d;

  font-size: 21px;
  font-weight: 900;
}

.gift-close {
  position: absolute;
  top: 50%;
  right: 14px;

  width: 38px;
  height: 38px;

  transform: translateY(-50%);

  border: 2px solid #85858d;
  border-radius: 50%;

  background: white;
  color: #66656d;

  font: inherit;
  font-size: 22px;

  cursor: pointer;
}


/* ---------- gifts ---------- */

.gift-list {
  min-height: 190px;
  padding: 14px;

  overflow-y: auto;
}

.gift-item {
  display: flex;
  align-items: center;
  gap: 14px;

  margin-bottom: 10px;
  padding: 14px 15px;

  border: 2px solid #dedee2;
  border-radius: 13px;

  background: white;

  box-shadow: 0 2px 4px rgba(0,0,0,.06);
}

.gift-item:last-child {
  margin-bottom: 0;
}

.gift-info {
  min-width: 0;
  flex: 1;

  display: flex;
  flex-direction: column;
  gap: 5px;

  color: #55545d;
}

.gift-info strong {
  font-size: 14px;
  font-weight: 900;
}

.gift-info span {
  color: #ff9f24;

  font-size: 16px;
  font-weight: 900;
}


/* ---------- buttons ---------- */

.gift-receive,
.gift-receive-all {
  border: 2px solid #329f98;
  border-radius: 12px;

  background: linear-gradient(#65ded5, #3fc8bd);
  color: white;

  font: inherit;
  font-weight: 900;

  cursor: pointer;

  box-shadow:
    inset 0 0 0 2px rgba(255,255,255,.5),
    0 2px 4px rgba(0,0,0,.12);
}

.gift-receive {
  min-width: 100px;
  min-height: 42px;

  padding: 7px 13px;
}

.gift-footer {
  display: flex;
  justify-content: center;

  padding: 14px;

  border-top: 2px solid #dedee2;

  background: white;
}

.gift-receive-all {
  min-width: 180px;
  min-height: 46px;

  padding: 8px 18px;

  font-size: 15px;
}


/* ---------- mobile ---------- */

@media (max-width: 600px) {

  .gift-modal {
    padding: 14px;
  }

  .gift-dialog {
    width: 100%;
    max-height: calc(100vh - 28px);
  }

  .gift-item {
    gap: 9px;
    padding: 11px;
  }

  .gift-info strong {
    font-size: 12px;
  }

  .gift-info span {
    font-size: 14px;
  }

  .gift-receive {
    min-width: 86px;
    font-size: 12px;
  }
}


