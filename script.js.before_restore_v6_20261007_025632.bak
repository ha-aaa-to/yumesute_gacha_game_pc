/* ===== DUGONG DRAG PROTOTYPE ===== */

(() => {

  const miniButton = document.getElementById("miniGameButton");
  const miniScreen = document.getElementById("miniGameScreen");
  const gachaScreen = document.getElementById("gachaScreen");
  const ownedScreen = document.getElementById("ownedScreen");

  const playArea = document.getElementById("dugongPlayArea");
  const dugong = document.getElementById("dugongPlayer");

  if (!miniButton || !miniScreen || !playArea || !dugong) return;

  /* ミニゲーム 화면 열기 */
  miniButton.addEventListener("click", () => {

    if (gachaScreen) gachaScreen.hidden = true;
    if (ownedScreen) ownedScreen.hidden = true;

    miniScreen.hidden = false;

    document
      .querySelectorAll(".gacha-tab")
      .forEach(tab => tab.classList.remove("active"));

    document
      .getElementById("ownedListButton")
      ?.classList.remove("active");

    miniButton.classList.add("active");
  });


  /*
   * 기존 selectGacha가 실행될 때 미니게임 화면 닫기.
   * 원래 가챠 동작은 그대로 실행.
   */
  if (typeof window.selectGacha === "function") {

    const selectGachaBeforeDugongPrototype = window.selectGacha;

    window.selectGacha = function(type) {

      miniScreen.hidden = true;
      miniButton.classList.remove("active");

      return selectGachaBeforeDugongPrototype(type);
    };
  }


  /* ===== 좌우 드래그 ===== */

  let dragging = false;
  let pointerOffsetX = 0;

  function moveDugong(clientX) {

    const areaRect = playArea.getBoundingClientRect();
    const dugongRect = dugong.getBoundingClientRect();

    const dugongWidth = dugongRect.width;

    let x =
      clientX -
      areaRect.left -
      pointerOffsetX;

    /* 게임 영역 밖으로 못 나가게 */
    x = Math.max(
      0,
      Math.min(
        x,
        areaRect.width - dugongWidth
      )
    );

    dugong.style.left = x + "px";
    dugong.style.transform = "none";
  }


  dugong.addEventListener("pointerdown", (event) => {

    event.preventDefault();

    dragging = true;

    const dugongRect =
      dugong.getBoundingClientRect();

    pointerOffsetX =
      event.clientX - dugongRect.left;

    dugong.classList.add("dragging");

    dugong.setPointerCapture?.(event.pointerId);
  });


  dugong.addEventListener("pointermove", (event) => {

    if (!dragging) return;

    event.preventDefault();

    /* Y좌표는 사용하지 않음 */
    moveDugong(event.clientX);
  });


  function stopDugongDrag(event) {

    if (!dragging) return;

    dragging = false;

    dugong.classList.remove("dragging");

    try {
      dugong.releasePointerCapture?.(event.pointerId);
    } catch (_) {}
  }


  dugong.addEventListener(
    "pointerup",
    stopDugongDrag
  );

  dugong.addEventListener(
    "pointercancel",
    stopDugongDrag
  );

})();

/* ===== DUGONG 066 CHART + AUDIO PROTOTYPE ===== */

(() => {

  const startButton =
    document.getElementById("dugongChartStart");

  const timeLabel =
    document.getElementById("dugongChartTime");

  const audio =
    document.getElementById("dugongGameAudio");

  const area =
    document.getElementById("dugongPlayArea");

  const stream =
    document.getElementById("dugongChartStream");

  if (
    !startButton ||
    !timeLabel ||
    !audio ||
    !area ||
    !stream
  ) return;


  /*
   * 원본:
   * 4040 × 1584
   *
   * 분석 결과:
   * 약 200px 폭의 세로 채보가
   * 왼쪽 → 오른쪽으로 이어져 있음.
   */
  const SOURCE_WIDTH = 4040;
  const SOURCE_HEIGHT = 1584;
  const SECTION_WIDTH = 200;

  const SECTION_COUNT =
    Math.floor(SOURCE_WIDTH / SECTION_WIDTH);

  /*
   * 일단 음악 전체 길이를 채보 전체 길이에 대응.
   * 정확한 오프셋은 이후 실제 플레이를 보며 조정.
   */
  /*
   * 채보 선행 표시용 임시 오프셋 제거.
   * 현재는 음원의 실제 재생 시간을 그대로 기준으로 삼는다.
   */
  const FALL_TIME = 0;

  /*
   * 원본 채보 한 줄(200px)을 게임판 전체 폭으로
   * 억지 확대하지 않고 작게 표시한다.
   *
   * → 화질 개선
   * → 위아래 시야 증가
   */
  const CHART_WIDTH_RATIO = 0.90;

  let playing = false;
  let raf = null;


  function formatTime(seconds) {

    if (!Number.isFinite(seconds))
      seconds = 0;

    const min =
      Math.floor(seconds / 60);

    const sec =
      Math.floor(seconds % 60)
        .toString()
        .padStart(2, "0");

    return `${min}:${sec}`;
  }


  /*
   * 4040px짜리 원본 PNG에서
   * 200px씩 잘라 보이도록 background-position 사용.
   *
   * 파일 자체를 20번 다운로드하는 게 아니라
   * 같은 PNG를 CSS로 잘라서 사용.
   */
  function buildChartPieces() {

    stream.innerHTML = "";

    for (
      let i = 0;
      i < SECTION_COUNT;
      i++
    ) {

      const piece =
        document.createElement("div");

      piece.className =
        "dugong-chart-piece";

      piece.dataset.index = i;

      piece.style.backgroundImage =
        'url("assets/dugong-charts/066/data066stl.png")';

      piece.style.backgroundRepeat =
        "no-repeat";

      /*
       * 원본에서 한 구간이 200/4040 비율.
       * 각 piece를 게임 영역 폭에 맞춰 확대.
       */
      piece.style.backgroundSize =
        `${SOURCE_WIDTH / SECTION_WIDTH * 100}% 100%`;

      piece.style.backgroundPosition =
        `${i / (SECTION_COUNT - 1) * 100}% 0%`;

      stream.appendChild(piece);
    }
  }


  function renderChart() {

    if (!playing) return;

    const duration =
      audio.duration || 100;

    const current =
      audio.currentTime;

    const progress =
      Math.max(
        0,
        Math.min(
          1,
          current / duration
        )
      );

    const areaHeight =
      area.clientHeight;

    const areaWidth =
      area.clientWidth;

    /*
     * 원본 200×1584의 비율을
     * 게임판 폭 기준으로 변환.
     */
    /*
     * 실제 채보 표시 폭.
     * 게임판 전체 폭보다 훨씬 작게 사용한다.
     */
    const chartWidth =
      areaWidth * CHART_WIDTH_RATIO;

    const pieceHeight =
      chartWidth *
      (SOURCE_HEIGHT / SECTION_WIDTH);

    const totalHeight =
      pieceHeight * SECTION_COUNT;

    /*
     * 시간 진행에 따라
     * 긴 채보가 위→아래로 흘러감.
     *
     * FALL_TIME 만큼 미리 화면 위에
     * 채보가 보이도록 여유를 둠.
     */
    const pxPerSecond =
      totalHeight / duration;

    const fallLead =
      pxPerSecond * FALL_TIME;

    const baseY =
      areaHeight -
      totalHeight +
      (progress * totalHeight) +
      fallLead;

    const pieces =
      stream.querySelectorAll(
        ".dugong-chart-piece"
      );

    pieces.forEach((piece, i) => {

      piece.style.width =
        `${chartWidth}px`;

      piece.style.height =
        `${pieceHeight}px`;

      piece.style.top =
        `${
          baseY +
          (SECTION_COUNT - 1 - i) *
          pieceHeight
        }px`;
    });


    timeLabel.textContent =
      `${formatTime(current)} / ${formatTime(duration)}`;


    if (
      audio.ended ||
      current >= duration
    ) {

      playing = false;



      return;
    }

    raf =
      requestAnimationFrame(
        renderChart
      );
  }


  async function startPrototype() {

    if (raf) {
      cancelAnimationFrame(raf);
      raf = null;
    }

    audio.pause();
    audio.currentTime = 0;

    buildChartPieces();

    playing = true;



    try {

      await audio.play();

      renderChart();

    } catch (error) {

      playing = false;

      console.error(error);

      startButton.textContent =
        "START";
    }
  }


  startButton.addEventListener(
    "click",
    startPrototype
  );


  audio.addEventListener(
    "ended",
    () => {

      playing = false;

      if (raf) {
        cancelAnimationFrame(raf);
        raf = null;
      }


    }
  );


  /*
   * 미니게임 화면을 벗어나면 음악 정지.
   */
  const menuButtons =
    document.querySelectorAll(
      ".gacha-tabs button:not(#miniGameButton)"
    );

  menuButtons.forEach(button => {

    button.addEventListener(
      "click",
      () => {

        playing = false;

        audio.pause();

        if (raf) {
          cancelAnimationFrame(raf);
          raf = null;
        }
      }
    );
  });

})();

/* ===== DUGONG VECTOR NOTE TEST ===== */
/*
  원작 듀공 미니게임 느낌 기준 재설계

  - 듀공 크기 유지
  - 좌우 이동만 가능
  - 채보는 화면 폭을 넓게 사용
  - 노트 자체는 작고 얇게
  - 노트 사이 회피 공간을 크게
  - 롱노트만 세로 길이를 유지
*/

(() => {

  const area =
    document.getElementById("dugongPlayArea");

  const start =
    document.getElementById("dugongChartStart");

  if (
    !area ||
    !start ||
    !window.DUGONG_CHART_066_V6 ||
    !Array.isArray(window.DUGONG_CHART_066_V6.events)
  ) {
    console.warn("Dugong chart data unavailable.");
    return;
  }


  /* ================================
     기본 설정
  ================================= */

  const SOURCE_LEFT = 40;
  const SOURCE_RIGHT = 190;
  const SOURCE_WIDTH =
    SOURCE_RIGHT - SOURCE_LEFT;

  /*
    첫 채보 칸 재생 시간.
    숫자가 작을수록 빠름.
  */
  /*
    실제 MP3 길이
  */
  const CHART_SECONDS = 99.946667;

  /*
    STELLA 채보 확인 영상과 게임 MP3를 오디오 파형으로 정렬한 뒤
    실제 첫/마지막 판정 시각을 환산한 값.

    reference video audio offset = +3.96 sec
    first judgment  : video 7.00 -> MP3 3.04
    last judgment   : video 99.35 -> MP3 95.39
  */
  const CHART_FIRST_HIT = 3.04;
  const CHART_LAST_HIT  = 95.39;

  /*
    화면에 몇 초 앞의 채보까지 보여줄지.
    높이가 긴 게임판에서 위쪽 노트가
    충분히 보이도록 설정.
  */
  /*
    노트 하나가 화면 위에서 아래까지
    이동하는 데 걸리는 시간.

    ↓ 작을수록 노트가 빠르게 내려온다.
    채보 자체의 노트 간격/타이밍에는 영향 없음.
  */
  const TRAVEL_SECONDS = 2.0;

  /*
    START 직후의 준비 시간.
    모든 노트의 도착 시점을 이만큼 뒤로 민다.

    START → 노트가 위에서 내려오기 시작
          → 2.5초 뒤부터 실제 회피 구간 진입
  */
  const LEAD_IN_SECONDS = 2.5;

  /*
    원본 좌표의 좌우 차이를 확대.

    단순히 노트를 크게 만드는 게 아니라
    노트의 '위치'만 서로 멀리 벌린다.
  */
  const LANE_SPREAD = 2.35;

  /*
    게임판 가장자리 여백.
  */
  const FIELD_MARGIN = 28;


  /* ================================
     레이어 생성
  ================================= */

  let layer =
    document.getElementById(
      "dugongVectorLayer"
    );

  if (!layer) {

    layer =
      document.createElement("div");

    layer.id =
      "dugongVectorLayer";

    layer.className =
      "dugong-vector-layer";

    area.appendChild(layer);
  }


  let field =
    document.getElementById(
      "dugongVectorField"
    );

  if (!field) {

    field =
      document.createElement("div");

    field.id =
      "dugongVectorField";

    field.className =
      "dugong-vector-field";

    layer.appendChild(field);
  }


  /* ================================
     노트 좌표 변환
  ================================= */

  function sourceCenterToRatio(note) {

    /*
      전체 채보 데이터에는 이미 0~1의 xNorm이 들어 있다.
      원본 첫 구간과 동일하게 중앙 기준으로 좌우 간격을 확대한다.
    */
    let ratio =
      Number(note.xNorm);

    ratio =
      0.5 +
      (ratio - 0.5) *
      LANE_SPREAD;

    return Math.max(
      0.025,
      Math.min(0.975, ratio)
    );
  }


  function getNoteWidth(note) {

    /*
      여기서 중요한 점:
      원본 검출 폭을 그대로 확대하지 않는다.

      게임판 크기를 기준으로
      작고 일정한 노트 폭을 사용한다.
    */

    if (note.kind === "long") {
      return 78;
    }

    if (note.kind === "special") {
      return 88;
    }

    return 75;
  }


  function getNoteHeight(note) {

    if (note.kind === "long") {

      /*
        롱노트의 길이 차이는 유지하되
        이전처럼 지나치게 굵고 거대하게
        보이지 않도록 제한.
      */
      return Math.max(
        42,
        Math.min(
          105,
          note.sourceH * 0.82
        )
      );
    }

    if (note.kind === "special") {
      return 8;
    }

    return 6;
  }


  /* ================================
     채보 생성
  ================================= */

  function buildNotes() {

    field.innerHTML = "";

    const fieldWidth =
      field.clientWidth;

    const usableWidth =
      Math.max(
        1,
        fieldWidth -
        FIELD_MARGIN * 2
      );

    window.DUGONG_CHART_066_V6.events.forEach(
      note => {

        const el =
          document.createElement("div");

        el.className =
          `dugong-vector-note ${note.kind} note-${note.color}`;

        /*
          V6의 xNorm은 이미 실제 채보 내부 위치를
          0~1로 정규화한 값이다.

          예전 LANE_SPREAD=2.35를 다시 적용하면
          양쪽 노트가 가장자리에 뭉치므로
          V6에서는 그대로 사용한다.
        */
        /*
          원작 영상처럼 채보가 화면 전체 폭으로
          흩어지지 않도록 중앙 쪽으로 압축한다.
        */
        const rawRatio =
          Number(note.xNorm);

        const ratio =
          Math.max(
            0.16,
            Math.min(
              0.84,
              0.5 +
              (rawRatio - 0.5) * 0.72
            )
          );

        const centerX =
          FIELD_MARGIN +
          usableWidth * ratio;


        /*
          듀공 크기는 유지하고
          노트 폭만 회피 가능하게 조정.
        */
        const width =
          note.kind === "long"
            ? 40
            : 50;

        el.style.width =
          `${width}px`;

        el.style.left =
          `${centerX - width / 2}px`;

        el.dataset.noteWidth =
          String(width);

        el.dataset.kind =
          note.kind;

        el.dataset.color =
          note.color;


        if (note.kind === "long") {

          const startTime =
            Number(note.startTime);

          const endTime =
            Number(note.endTime);

          /*
            롱노트의 음악상 지속시간을 저장한다.
            실제 픽셀 높이는 render()에서
            게임판 높이와 TRAVEL_SECONDS를 이용해 계산.
          */
          el.dataset.time =
            String(startTime);

          el.dataset.endTime =
            String(endTime);

          el.style.height = "20px";

        } else {

          el.dataset.time =
            String(
              Number(note.hitTime)
            );

          el.style.height = "8px";
        }


        /*
          원본 색 구분을 게임용으로 깔끔하게 재현.
          원본 PNG 그래픽 자체는 사용하지 않는다.
        */
        if (note.color === "blue") {

          el.style.background =
            "linear-gradient(90deg,#16d9ff,#7cf2ff,#16d9ff)";

          el.style.boxShadow =
            "0 0 8px rgba(50,220,255,.8)";

        } else if (note.color === "purple") {

          el.style.background =
            "linear-gradient(90deg,#9b43ff,#d06cff,#9b43ff)";

          el.style.boxShadow =
            "0 0 8px rgba(190,80,255,.75)";

        } else if (note.color === "yellow") {

          el.style.background =
            "linear-gradient(90deg,#ffb928,#ffe76a,#ffb928)";

          el.style.boxShadow =
            "0 0 7px rgba(255,205,50,.7)";

        } else {

          el.style.background =
            "linear-gradient(90deg,#ff4f9a,#ff8abc,#ff4f9a)";

          el.style.boxShadow =
            "0 0 7px rgba(255,70,150,.7)";
        }

        el.style.borderRadius =
          note.kind === "long"
            ? "7px"
            : "999px";

        field.appendChild(el);
      }
    );
  }


  /* ================================
     애니메이션
  ================================= */

  let running = false;
  let startedAt = 0;
  let raf = null;


  function render(now) {

    if (!running) return;

    /*
      음악을 마스터 시계로 사용한다.
      프레임 드롭이 생겨도 채보와 음악이 따로 밀리지 않는다.
    */
    const audio =
      document.getElementById(
        "dugongGameAudio"
      );

    const elapsed =
      audio && !audio.paused
        ? audio.currentTime
        : (now - startedAt) / 1000;

    const h =
      field.clientHeight;

    /*
      노트 간격은 SECTION_SECONDS의 시간축을 유지하고,
      화면을 내려오는 속도만 TRAVEL_SECONDS로 결정한다.
    */
    const pixelsPerSecond =
      h / TRAVEL_SECONDS;


    field
      .querySelectorAll(
        ".dugong-vector-note"
      )
      .forEach(note => {

        const hitTime =
          Number(
            note.dataset.time
          );

        const remaining =
          hitTime - elapsed;

        /*
          판정 2초 전:
            y = 0  → 화면 맨 위

          판정 순간:
            y = h  → 화면 맨 아래

          따라서 노트가 음악에 맞춰
          위에서 아래로 일정한 속도로 내려온다.
        */
        const y =
          h -
          remaining *
          pixelsPerSecond;


        if (
          note.dataset.kind === "long"
        ) {

          const endTime =
            Number(
              note.dataset.endTime
            );

          const duration =
            Math.max(
              0.10,
              endTime - hitTime
            );

          /*
            롱노트 지속시간을 실제 화면 길이로 표현.
            너무 거대한 벽이 되지 않도록 상한만 둔다.
          */
          const longHeight =
            Math.max(
              28,
              Math.min(
                h * 0.55,
                duration *
                pixelsPerSecond
              )
            );

          note.style.height =
            `${longHeight}px`;

          /*
            판정선에 롱노트의 아래쪽 끝이
            먼저 도착하도록 위로 길게 뻗는다.
          */
          note.style.transform =
            `translateY(${y - longHeight}px)`;

        } else {

          note.style.transform =
            `translateY(${y}px)`;
        }


        /*
          아직 화면 위 2초 밖이거나
          이미 화면 아래로 충분히 지나간 노트는 숨김.
        */
        note.style.visibility =
          remaining > TRAVEL_SECONDS + 0.05 ||
          remaining < -0.35
            ? "hidden"
            : "visible";
      });


    if (
      elapsed >
      CHART_SECONDS +
      0.8
    ) {

      running = false;



      return;
    }


    raf =
      requestAnimationFrame(
        render
      );
  }


  /* ================================
     테스트 시작
  ================================= */

  function startVectorGame() {

    /*
      현재는 비주얼/속도 확인 단계이므로
      기존 음악 프로토타입은 정지.
    */
    const audio =
      document.getElementById(
        "dugongGameAudio"
      );

    if (audio) {
      audio.pause();
      audio.currentTime = 0;
    }


    if (raf) {
      cancelAnimationFrame(raf);
    }


    buildNotes();

    /* 시작 위치는 항상 중앙 */
    centerDugongPlayer();

    running = true;

    startedAt =
      performance.now();

    /*
      전체 채보와 음원을 같은 순간 시작.
      정확한 싱크 offset은 전체 채보 확인 후 조정한다.
    */
    if (audio) {
      audio.play().catch(error => {
        console.warn("Dugong audio play failed:", error);
      });
    }

    raf =
      requestAnimationFrame(
        render
      );
  }


  /*
    미니게임 화면에 들어오는 순간부터
    START 전 듀공을 가로 정중앙에 배치한다.

    hidden 상태에서는 area.clientWidth가
    정확하지 않을 수 있으므로 탭 클릭 후
    두 프레임 뒤에 다시 계산한다.
  */
  const miniGameTab =
    document.getElementById("miniGameButton");

  if (miniGameTab) {

    miniGameTab.addEventListener(
      "click",
      () => {

        requestAnimationFrame(() => {

          requestAnimationFrame(() => {

            centerDugongPlayer();

            /*
              듀공의 중앙 배치가 브라우저에 반영된
              다음 프레임에서 START 위치를 확정한다.
            */
            requestAnimationFrame(() => {
              positionDugongStartButton();
            });

          });

        });

      }
    );

  }


  start.addEventListener(
    "click",
    event => {

      event.stopImmediatePropagation();

      /* 게임 시작 후 START / RESTART 버튼은 표시하지 않음 */
      start.style.display = "none";

      startVectorGame();

    },
    true
  );


  /* ================================
     듀공 이동 범위
  ================================= */

  function positionDugongStartButton() {

    const player =
      area.querySelector(".dugong-player");

    if (!player || !start) return;

    const areaRect =
      area.getBoundingClientRect();

    const playerRect =
      player.getBoundingClientRect();

    /*
      START 버튼의 중심 = 듀공의 가로 중심.
    */
    const centerX =
      playerRect.left -
      areaRect.left +
      playerRect.width / 2;

    /*
      버튼의 아래쪽이 듀공 머리에서
      정확히 6px 위에 오도록 한다.
    */
    const bottom =
      areaRect.bottom -
      playerRect.top +
      6;

    /*
      기존 CSS 규칙이 여러 개 있어도
      이 위치가 최우선으로 적용되게 한다.
    */
    start.style.setProperty(
      "position",
      "absolute",
      "important"
    );

    start.style.setProperty(
      "left",
      `${centerX}px`,
      "important"
    );

    start.style.setProperty(
      "right",
      "auto",
      "important"
    );

    start.style.setProperty(
      "top",
      "auto",
      "important"
    );

    start.style.setProperty(
      "bottom",
      `${bottom}px`,
      "important"
    );

    start.style.setProperty(
      "transform",
      "translateX(-50%)",
      "important"
    );

    start.style.setProperty(
      "z-index",
      "50",
      "important"
    );
  }


  function centerDugongPlayer() {

    const player =
      area.querySelector(
        ".dugong-player"
      );

    if (!player) return;

    /*
      START / RESTART 때마다
      듀공의 중심을 게임판 중앙에 맞춘다.
    */
    const playerWidth =
      player.getBoundingClientRect().width;

    const centerLeft =
      (area.clientWidth - playerWidth) / 2;

    player.style.left =
      `${centerLeft}px`;

    player.style.transform =
      "none";

    /* 대기 화면 START도 듀공 바로 위로 */
    positionDugongStartButton();
  }


  function clampPlayer() {

    const player =
      area.querySelector(
        ".dugong-player"
      );

    if (!player) return;


    const areaRect =
      area.getBoundingClientRect();

    const playerRect =
      player.getBoundingClientRect();


    /*
      게임판 거의 전체 폭을 사용할 수 있게 하되
      듀공 몸 전체는 화면 안에 남긴다.
    */
    const minLeft =
      FIELD_MARGIN;

    const maxLeft =
      areaRect.width -
      FIELD_MARGIN -
      playerRect.width;


    const currentLeft =
      playerRect.left -
      areaRect.left;


    const nextLeft =
      Math.max(
        minLeft,
        Math.min(
          maxLeft,
          currentLeft
        )
      );


    if (
      Math.abs(
        nextLeft -
        currentLeft
      ) > 0.5
    ) {

      player.style.left =
        `${nextLeft}px`;

      player.style.transform =
        "none";
    }
  }


  /*
    미니게임 대기 화면에서도
    듀공은 항상 정중앙에서 시작한다.
  */
  function centerIdleDugong() {
    requestAnimationFrame(() => {
      centerDugongPlayer();
    });
  }


  function maintainPlayerBounds() {

    clampPlayer();

    requestAnimationFrame(
      maintainPlayerBounds
    );
  }


  /*
    페이지가 로드됐을 때부터 중앙.
    START를 누르기 전에도 이 위치를 유지한다.
  */
  centerIdleDugong();

  requestAnimationFrame(
    maintainPlayerBounds
  );

})();

