    );

  });



/* ===== OWNED CARD AWAKENING PREFERENCE ===== */

const OWNED_ART_PREF_KEY = "yumesteOwnedArtPreference";

function loadOwnedArtPreferences() {
  try {
    return JSON.parse(
      localStorage.getItem(OWNED_ART_PREF_KEY) || "{}"
    );
  } catch {
    return {};
  }
}

function saveOwnedArtPreference(card, awakened) {
  if (!card || !card.before || !card.after) return;

  const prefs = loadOwnedArtPreferences();
  prefs[card.before] = awakened ? "after" : "before";

  localStorage.setItem(
    OWNED_ART_PREF_KEY,
    JSON.stringify(prefs)
  );
}

function getPreferredOwnedArt(card) {
  if (!card || !card.after) return card.before;

  const prefs = loadOwnedArtPreferences();

  return prefs[card.before] === "after"
    ? card.after
    : card.before;
}


/*
  所持一覧이 다시 렌더링될 때
  사용자가 마지막으로 선택한 각전/각후 일러 적용
*/
function applyOwnedArtPreferences() {
  const cards = getOwnedCardsForDisplay();

  document
    .querySelectorAll("#ownedResults .owned-card")
    .forEach((element, index) => {

      const card = cards[index];
      const img = element.querySelector("img");

      if (card && img) {
        img.src = getPreferredOwnedArt(card);
      }
    });
}


/*
  기존 renderOwnedList 실행 후
  저장된 일러 선택 상태 적용
*/
const originalRenderOwnedListForArt =
  renderOwnedList;

renderOwnedList = function() {
  originalRenderOwnedListForArt();
  applyOwnedArtPreferences();
};


/*
  ★4 확대창에서 before/after 이미지가 바뀌는 순간을 감지.
  기존 화살표 기능 자체는 수정하지 않는다.
*/
const ownedArtObserver =
  new MutationObserver(() => {

    const ownedScreen =
      document.getElementById("ownedScreen");

    if (!ownedScreen || ownedScreen.hidden) return;

    const visibleImages =
      [...document.querySelectorAll(
        "img"
      )].filter(img => {

        const style =
          getComputedStyle(img);

        return (
          img.offsetParent !== null &&
          style.display !== "none" &&
          img.src
        );
      });

    for (const card of ALL_CARDS) {

      if (!card.after) continue;

      const beforeURL =
        new URL(card.before, location.href).href;

      const afterURL =
        new URL(card.after, location.href).href;

      const modalImage =
        visibleImages.find(img =>
          img.src === beforeURL ||
          img.src === afterURL
        );

      if (!modalImage) continue;

      /*
        소지일람 썸네일 자체는 제외하고
        확대된 이미지에서의 변경만 저장
      */
      if (modalImage.closest("#ownedResults")) {
        continue;
      }

      const awakened =
        modalImage.src === afterURL;

      saveOwnedArtPreference(
        card,
        awakened
      );

      /*
        소지일람 뒤쪽 썸네일도 즉시 변경
      */
      const ownedCards =
        getOwnedCardsForDisplay();

      const index =
        ownedCards.findIndex(
          item => item.before === card.before
        );

      const thumbs =
        document.querySelectorAll(
          "#ownedResults .owned-card > img"
        );

      if (index >= 0 && thumbs[index]) {
        thumbs[index].src =
          awakened
            ? card.after
            : card.before;
      }

      break;
    }
  });


ownedArtObserver.observe(
  document.body,
  {
    subtree: true,
    attributes: true,
    attributeFilter: ["src"]
  }
);

/* ===== OWNED THUMBNAIL AWAKENING FIX ===== */

function refreshOwnedThumbnails() {
  const cards = getOwnedCardsForDisplay();
  const thumbs = document.querySelectorAll(
    "#ownedResults .owned-card > img"
  );

  cards.forEach((card, i) => {
    if (!thumbs[i]) return;

    const prefs = loadOwnedArtPreferences();
    const useAfter =
      card.after &&
      prefs[card.before] === "after";

    thumbs[i].src =
      useAfter ? card.after : card.before;
  });
}


/*
  확대창에서 화살표를 누른 직후,
  실제로 표시된 이미지가 before인지 after인지 확인해서 저장.
  화살표 버튼의 정확한 id/class를 몰라도
  클릭 후 이미지 변경을 확인하도록 처리.
*/
document.addEventListener("click", event => {

  const ownedScreen =
    document.getElementById("ownedScreen");

  if (!ownedScreen || ownedScreen.hidden) return;

  setTimeout(() => {

    for (const card of ALL_CARDS) {
      if (!card.after) continue;

      const beforeURL =
        new URL(card.before, location.href).href;

      const afterURL =
        new URL(card.after, location.href).href;

      const images =
        [...document.querySelectorAll("img")]
        .filter(img =>
          !img.closest("#ownedResults") &&
          img.offsetParent !== null
        );

      const image =
        images.find(img =>
          img.src === beforeURL ||
          img.src === afterURL
        );

      if (!image) continue;

      saveOwnedArtPreference(
        card,
        image.src === afterURL
      );

      refreshOwnedThumbnails();
      break;
    }

  }, 50);

});


/*
  所持一覧을 열거나 필터를 바꿔 다시 그렸을 때도 적용
*/
const oldRenderOwnedListThumbFix =
  renderOwnedList;

renderOwnedList = function() {
  oldRenderOwnedListThumbFix();

  requestAnimationFrame(() => {
    refreshOwnedThumbnails();
  });
};

/* ===== OWNED MODAL START IMAGE FIX ===== */

/*
  所持一覧의 ★4 카드를 열었을 때
  사용자가 저장해 둔 각전/각후 상태를
  확대창의 첫 이미지에도 그대로 적용한다.
*/
document.addEventListener("click", event => {

  const ownedCard =
    event.target.closest("#ownedResults .owned-card");

  if (!ownedCard) return;


  /*
    클릭된 카드의 현재 썸네일 src를 이용해
    해당 카드 데이터 찾기
  */
  const thumb =
    ownedCard.querySelector("img");

  if (!thumb) return;


  const card = ALL_CARDS.find(item => {

    const beforeURL =
      new URL(item.before, location.href).href;

    const afterURL =
      item.after
        ? new URL(item.after, location.href).href
        : null;

    return (
      thumb.src === beforeURL ||
      thumb.src === afterURL
    );
  });


  if (!card || !card.after) return;


  const prefs =
    loadOwnedArtPreferences();

  const preferredSrc =
    prefs[card.before] === "after"
      ? card.after
      : card.before;


  /*
    기존 openCard()가 먼저 실행된 다음
    확대창 이미지를 원하는 상태로 맞춘다.
  */
  requestAnimationFrame(() => {

    const preferredURL =
      new URL(preferredSrc, location.href).href;


    const modalImages =
      [...document.querySelectorAll("img")]
      .filter(img =>
        !img.closest("#ownedResults") &&
        img.offsetParent !== null
      );


    /*
      현재 열린 카드 확대 이미지를 찾아서 교체
    */
    const currentBeforeURL =
      new URL(card.before, location.href).href;

    const currentAfterURL =
      new URL(card.after, location.href).href;


    const modalImage =
      modalImages.find(img =>
        img.src === currentBeforeURL ||
        img.src === currentAfterURL
      );


    if (modalImage) {
      modalImage.src = preferredURL;
    }

  });

});


/* ===== OWNED MISSING SWITCH FINAL ===== */

let ownedDisplayMode = "owned";


function getMissingCardsForDisplay() {

  return ALL_CARDS
    .filter(card => getOwnedCardCount(card) === 0)
    .filter(card => {
      if (ownedRankFilter === "all") return true;
      return card.rank === Number(ownedRankFilter);
    })
    .sort((a, b) => {

      if (b.rank !== a.rank) {
        return b.rank - a.rank;
      }

      const actorCompare =
        String(a.actor).localeCompare(
          String(b.actor),
          "ja"
        );

      if (actorCompare !== 0) {
        return actorCompare;
      }

      return String(a.title).localeCompare(
        String(b.title),
        "ja"
      );
    });
}


const ownedOriginalGetCards =
  getOwnedCardsForDisplay;


getOwnedCardsForDisplay = function() {

  if (ownedDisplayMode === "missing") {
    return getMissingCardsForDisplay();
  }

  return ownedOriginalGetCards();
};


function changeOwnedDisplayMode(mode) {

  ownedDisplayMode = mode;

  document
    .getElementById("ownedViewOwned")
    ?.classList.toggle(
      "active",
      mode === "owned"
    );

  document
    .getElementById("ownedViewMissing")
    ?.classList.toggle(
      "active",
      mode === "missing"
    );

  renderOwnedList();

  document
    .querySelectorAll("#ownedResults .owned-card")
    .forEach(card => {
      card.classList.toggle(
        "is-missing",
        mode === "missing"
      );
    });
}


document
  .getElementById("ownedViewOwned")
  ?.addEventListener(
    "click",
    () => changeOwnedDisplayMode("owned")
  );


document
  .getElementById("ownedViewMissing")
  ?.addEventListener(
    "click",
    () => changeOwnedDisplayMode("missing")
  );


/* ===== OWNED LIST FINAL SORT + MISSING STYLE ===== */

/* 액터 고정 정렬 순서 */
const OWNED_ACTOR_ORDER = [
  "鳳ここな",
  "静香",
  "カトリナ・グリーベル",
  "新妻八恵",
  "柳場ぱんだ",
  "流石知冴",

  "連尺野初魅",
  "烏森大黒",
  "舎人仁花子",
  "萬容",
  "筆島しぐれ",

  "千寿暦",
  "ラモーナ・ウォルフ",
  "王雪",
  "リリヤ・クルトベイ",
  "与那国緋花里",

  "千寿いろは",
  "白丸美兎",
  "阿岐留カミラ",
  "猫足蕾",
  "本巣叶羽",

  "高海千歌",
  "桜内梨子",
  "黒澤ダイヤ",
  "津島善子",
  "黒澤ルビィ"
];


function sortOwnedCardsFinal(cards) {

  return [...cards].sort((a, b) => {

    /* ① 2성 → 3성 → 4성 */
    if (a.rank !== b.rank) {
      return a.rank - b.rank;
    }


    /* ② 지정 액터 순서 */
    const ai =
      OWNED_ACTOR_ORDER.indexOf(a.actor);

    const bi =
      OWNED_ACTOR_ORDER.indexOf(b.actor);

    const safeAi =
      ai === -1 ? 9999 : ai;

    const safeBi =
      bi === -1 ? 9999 : bi;

    if (safeAi !== safeBi) {
      return safeAi - safeBi;
    }


    /* ③ 같은 액터/레어도 안에서는 카드명 */
    return String(a.title).localeCompare(
      String(b.title),
      "ja"
    );
  });
}


/*
  기존 소지/미소지 판별은 그대로 사용하고
  마지막 출력 순서만 여기서 통일
*/
const ownedGetCardsBeforeFinalSort =
  getOwnedCardsForDisplay;

getOwnedCardsForDisplay = function() {

  return sortOwnedCardsFinal(
    ownedGetCardsBeforeFinalSort()
  );
};


/*
  render 후 현재 모드 표시를 results 자체에 부여.
  이렇게 해야 미소지 투명도가 확실하게 적용됨.
*/
const ownedRenderBeforeMissingStyle =
  renderOwnedList;

renderOwnedList = function() {

  ownedRenderBeforeMissingStyle();

  const results =
    document.getElementById("ownedResults");

  if (!results) return;

  results.classList.toggle(
    "showing-missing",
    typeof ownedDisplayMode !== "undefined" &&
    ownedDisplayMode === "missing"
  );
};



/* ===== RARITY ORDER TOGGLE ===== */

let ownedRankDescending = false;


/*
  기존 최종 정렬 함수에서
  레어리티 방향만 선택 가능하게 변경
*/
const ownedSortBeforeRankToggle =
  sortOwnedCardsFinal;

sortOwnedCardsFinal = function(cards) {

  return [...cards].sort((a, b) => {

    /* 레어리티 */
    if (a.rank !== b.rank) {

      return ownedRankDescending
        ? b.rank - a.rank
        : a.rank - b.rank;
    }


    /* 액터 순서는 항상 고정 */
    const ai =
      OWNED_ACTOR_ORDER.indexOf(a.actor);

    const bi =
      OWNED_ACTOR_ORDER.indexOf(b.actor);

    const safeAi =
      ai === -1 ? 9999 : ai;

    const safeBi =
      bi === -1 ? 9999 : bi;

    if (safeAi !== safeBi) {
      return safeAi - safeBi;
    }


    return String(a.title).localeCompare(
      String(b.title),
      "ja"
    );
  });
};


function updateOwnedRankOrderButton() {

  const button =
    document.getElementById(
      "ownedRankOrderButton"
    );

  if (!button) return;

  button.textContent =
    ownedRankDescending
      ? "★★★★ → ★★"
      : "★★ → ★★★★";
}


document
  .getElementById("ownedRankOrderButton")
  ?.addEventListener("click", () => {

    ownedRankDescending =
      !ownedRankDescending;

    updateOwnedRankOrderButton();

    renderOwnedList();
  });


updateOwnedRankOrderButton();


/* ===== SAFE RARITY REVERSE CLICK ===== */

let ownedRarityReverse = false;

const rarityReverseButton =
  document.getElementById("ownedRankOrderButton");

if (rarityReverseButton) {

  rarityReverseButton.textContent = "↕";

  rarityReverseButton.onclick = function () {

    ownedRarityReverse = !ownedRarityReverse;

    const originalDirection =
      sortOwnedCardsFinal;

    sortOwnedCardsFinal = function(cards) {

      return [...cards].sort((a, b) => {

        /* 레어리티만 정/역순 */
        if (a.rank !== b.rank) {
          return ownedRarityReverse
            ? b.rank - a.rank
            : a.rank - b.rank;
        }

        /* 같은 레어리티에서는 기존 액터 순서 */
        const ai = OWNED_ACTOR_ORDER.indexOf(a.actor);
        const bi = OWNED_ACTOR_ORDER.indexOf(b.actor);

        const safeAi = ai < 0 ? 9999 : ai;
        const safeBi = bi < 0 ? 9999 : bi;

        if (safeAi !== safeBi) {
          return safeAi - safeBi;
        }

        return String(a.title).localeCompare(
          String(b.title),
          "ja"
        );
      });
    };

    renderOwnedList();
  };
}

