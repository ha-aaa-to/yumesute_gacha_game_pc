*{box-sizing:border-box}body{margin:0;background:#f7f5fb;color:#292631;font-family:-apple-system,BlinkMacSystemFont,"Noto Sans JP","Noto Sans KR",sans-serif}main{max-width:980px;margin:auto;padding:36px 20px 70px}.eyebrow{font-size:11px;letter-spacing:2px;opacity:.5}h1{font-size:38px;margin:8px 0 24px}h1 span{font-size:17px;letter-spacing:2px}.banner{padding:25px;border-radius:22px;background:linear-gradient(135deg,#fff,#ece7fa);margin-bottom:16px}.banner b{font-size:11px;background:#292631;color:#fff;padding:6px 10px;border-radius:20px}.banner h2{font-size:28px;margin:12px 0}.actions{display:flex;gap:10px;flex-wrap:wrap}.actions button{border:0;border-radius:12px;padding:13px 20px;font-weight:700;cursor:pointer}.primary{background:#292631!important;color:white}.stats{margin:18px 0;color:#777;font-size:13px}#results{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;align-items:stretch}.empty{grid-column:1/-1;text-align:center;padding:70px;color:#aaa}.card{border:0;background:#fff;border-radius:16px;padding:0;overflow:hidden;text-align:left;cursor:pointer;box-shadow:0 5px 18px #0001;display:flex;flex-direction:column;min-width:0;height:100%}.card img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block;flex:none}.info{padding:12px;display:flex;flex-direction:column;flex:1}.stars{letter-spacing:1px}.title{font-weight:800;margin-top:5px;font-size:14px}.actor{font-size:11px;color:#777;margin-top:auto;padding-top:5px}.modal{position:fixed;inset:0;background:#000b;z-index:50;display:flex;align-items:center;justify-content:center;padding:32px;overflow:auto}.modal[hidden]{display:none}.dialog{position:relative;display:inline-block;width:auto;height:auto;max-width:92vw;max-height:88vh;background:transparent;color:white;overflow:visible;line-height:0}.dialog>img{display:block;width:auto;height:auto;max-width:92vw;max-height:88vh;object-fit:contain;border-radius:12px;background:transparent}.dialog #close{position:absolute;right:-14px;top:-14px;width:40px;height:40px;border:0;border-radius:50%;font-size:25px;line-height:40px;background:#222e;color:#fff;cursor:pointer;z-index:4;box-shadow:0 2px 10px #0005}.meta{position:absolute;left:0;right:0;bottom:0;padding:48px 16px 14px 68px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;background:linear-gradient(transparent,#000b);pointer-events:none;line-height:1.35;border-radius:0 0 12px 12px}.meta span{opacity:.8;font-size:13px}.awaken-arrow{position:absolute;left:14px;bottom:12px;width:44px;height:44px;border:1px solid #ffffff88;border-radius:50%;background:#111b;color:#fff;display:grid;place-items:center;cursor:pointer;z-index:5;backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);padding:8px;line-height:1}.awaken-arrow svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;display:block}.awaken-arrow[hidden]{display:none}.awaken-arrow:active{transform:rotate(25deg)}@media(max-width:900px){#results{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:600px){main{padding-left:14px;padding-right:14px}#results{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.card img{aspect-ratio:16/9}.title{font-size:12px}.modal{padding:18px}.dialog,.dialog>img{max-width:94vw;max-height:82vh}.dialog #close{right:-8px;top:-10px}.meta{padding:44px 12px 10px 62px}.awaken-arrow{left:10px;bottom:8px;width:42px;height:42px}}
/* v8: mobile-first responsive tuning */
@media (max-width: 600px){
  body{background:#f8f7fb}
  main{width:100%;max-width:none;padding:20px 12px 42px}
  .eyebrow{font-size:9px;letter-spacing:1.4px;margin:0 0 4px}
  h1{font-size:27px;line-height:1.05;margin:6px 0 16px}
  h1 span{display:block;font-size:11px;letter-spacing:1.6px;margin-top:5px}
  .banner{padding:17px 16px;border-radius:18px;margin-bottom:12px}
  .banner b{font-size:9px;padding:5px 8px}
  .banner h2{font-size:20px;line-height:1.2;margin:10px 0 8px}
  .banner p{font-size:13px;margin:7px 0}
  .banner small{font-size:10px}
  .actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .actions button{min-height:46px;padding:11px 8px;border-radius:12px;font-size:13px}
  .actions #clear{grid-column:1/-1;min-height:40px}
  .stats{margin:13px 2px 14px;font-size:11px;line-height:1.7;white-space:normal}
  #results{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;align-items:stretch}
  .empty{padding:48px 8px;font-size:13px}
  .card{border-radius:12px;box-shadow:0 3px 12px #0000000d}
  .card img{aspect-ratio:16/9;object-fit:cover}
  .info{padding:9px 9px 10px;min-height:86px}
  .stars{font-size:12px;line-height:1}
  .title{font-size:11.5px;line-height:1.35;margin-top:6px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:31px}
  .actor{font-size:9.5px;padding-top:5px}
  .modal{padding:16px 12px;background:#000c}
  .dialog{max-width:calc(100vw - 24px);max-height:84vh}
  .dialog>img{max-width:calc(100vw - 24px);max-height:84vh;border-radius:10px}
  .dialog #close{right:7px;top:7px;width:36px;height:36px;line-height:34px;font-size:23px;background:#111a;box-shadow:none}
  .meta{padding:42px 12px 10px 58px;border-radius:0 0 10px 10px;gap:6px;font-size:12px}
  .meta span{font-size:10px}
  .awaken-arrow{left:9px;bottom:8px;width:40px;height:40px;padding:7px;background:#111a}
}

@media (max-width: 360px){
  main{padding-left:9px;padding-right:9px}
  #results{gap:7px}
  .info{padding:8px;min-height:82px}
  .title{font-size:10.5px}
  .actions button{font-size:12px}
}

/* Gacha selector */

.gacha-tabs{
  display:flex;
  gap:10px;
  margin-bottom:14px;
}

.gacha-tab{
  border:1px solid #ddd8e8;
  background:#fff;
  color:#777;
  padding:10px 17px;
  border-radius:999px;
  font-weight:800;
  cursor:pointer;
  transition:.18s;
}

.gacha-tab:hover{
  transform:translateY(-1px);
}

.gacha-tab.active{
  background:#292631;
  color:#fff;
  border-color:#292631;
}


/* =========================================
   YUMESTE DESIGN UPDATE
   ========================================= */

@font-face{
  font-family:"YumesteUI";
  src:url("RoNOWStd-GBs.otf") format("opentype");
  font-display:swap;
}

html,
body,
button{
  font-family:"YumesteUI",
              "Noto Sans JP",
              "Hiragino Sans",
              sans-serif;
}

body{
  background:#fff;
  color:#25252b;
}

main{
  max-width:1100px;
  padding-top:46px;
}

.eyebrow{
  margin:0 0 8px;
  font-size:12px;
  letter-spacing:1.4px;
  color:#999;
}

h1{
  margin:0 0 32px;
  font-size:38px;
  font-weight:700;
  letter-spacing:.03em;
}


/* ---------- GACHA LOGOS ---------- */

.gacha-tabs{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
  margin:0 0 22px;
}

.gacha-tab{
  position:relative;
  height:105px;
  padding:16px 28px;

  display:flex;
  align-items:center;
  justify-content:center;

  background:#fff;
  border:1px solid #e7e7eb;
  border-radius:8px;

  cursor:pointer;

  transition:
    transform .18s ease,
    border-color .18s ease,
    box-shadow .18s ease,
    background .18s ease;
}

.gacha-tab img{
  display:block;
  max-width:88%;
  max-height:70px;
  width:auto;
  height:auto;
  object-fit:contain;
}

.gacha-tab:hover{
  transform:translateY(-2px);
  border-color:#91e5dd;
  background:#fbffff;
  box-shadow:0 8px 25px rgba(41,196,184,.10);
}

.gacha-tab.active{
  border-color:#48d7ca;
  box-shadow:
    0 0 0 2px rgba(72,215,202,.12),
    0 7px 22px rgba(72,215,202,.10);
}

.gacha-tab.active::after{
  content:"";
  position:absolute;
  left:18px;
  right:18px;
  bottom:-1px;
  height:3px;
  border-radius:3px 3px 0 0;
  background:#48d7ca;
}


/* ---------- SELECTED GACHA ---------- */

.banner{
  position:relative;
  overflow:hidden;

  padding:27px 30px;
  margin-bottom:20px;

  border:1px solid #e8ecee;
  border-radius:8px;

  background:
    linear-gradient(115deg,#fff 0%,#fbffff 55%,#effcfb 100%);
}

.banner::after{
  content:"";
  position:absolute;
  width:170px;
  height:170px;
  right:-55px;
  top:-80px;
  border-radius:50%;
  background:rgba(75,218,205,.08);
}

.banner.collab{
  background:
    linear-gradient(115deg,#fff 0%,#fffafd 55%,#f2fbff 100%);
}

.banner b{
  display:inline-block;

  padding:0;
  border-radius:0;

  background:none;
  color:#37bdb2;

  font-size:11px;
  letter-spacing:2px;
}

.banner h2{
  position:relative;
  z-index:1;

  margin:10px 0 0;
  font-size:23px;
  font-weight:700;
  letter-spacing:.02em;
}


/* ---------- PULL BUTTONS ---------- */

.actions{
  display:flex;
  align-items:stretch;
  gap:10px;
}

.actions button{
  min-width:150px;
  min-height:58px;

  padding:9px 18px;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  border:1px solid #dfe4e6;
  border-radius:7px;

  background:#fff !important;
  color:#292931 !important;

  font-family:inherit;
  font-weight:700;

  transition:
    background .16s ease,
    color .16s ease,
    border-color .16s ease,
    transform .16s ease,
    box-shadow .16s ease;
}

.actions button:hover{
  background:#43d3c7 !important;
  color:#fff !important;
  border-color:#43d3c7;
  transform:translateY(-1px);
  box-shadow:0 5px 16px rgba(52,194,183,.18);
}

.pull-label{
  font-size:15px;
  line-height:1.2;
}

.pull-cost{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:4px;

  margin-top:4px;

  font-size:11px;
  line-height:1;
  opacity:.72;
}

.pull-cost img{
  width:17px;
  height:17px;
  object-fit:contain;
  border-radius:0;
}


/* 결과 초기화 버튼에는 재화 영역 없음 */

#clear{
  min-width:130px;
}


/* ---------- STATS ---------- */

.stats{
  margin:20px 0;
  padding-bottom:12px;

  border-bottom:1px solid #eeeeef;

  color:#85858d;
  font-size:13px;
}

.stats b{
  color:#292931;
}


/* ---------- EMPTY ---------- */

.empty{
  color:#aaaeb2;
  letter-spacing:.04em;
}


/* ==================================================
   YUMESTE UI - GAME STYLE REVISION
   ================================================== */

/* 전체 글자 */
body,
button{
  font-family:"YumesteUI",
              "Hiragino Kaku Gothic ProN",
              "Yu Gothic",
              sans-serif;
  font-weight:700;
}

body{
  background:#fff;
  color:#4c4b55;
}

main{
  max-width:1080px;
}


/* ----------------------------------
   HEADER
---------------------------------- */

.eyebrow{
  font-size:11px;
  font-weight:700;
  letter-spacing:.07em;
  color:#aaaab1;
}

h1{
  color:#4b4a53;
  font-size:34px;
  font-weight:800;
  letter-spacing:.02em;
}


/* ----------------------------------
   SMALL GACHA SELECTOR
---------------------------------- */

.gacha-tabs{
  display:flex;
  grid-template-columns:none;

  align-items:center;
  justify-content:flex-start;

  gap:10px;
  margin:0 0 16px;
}


/* 기존 큰 카드 스타일 제거 */
.gacha-tab{
  width:150px;
  height:52px;
  min-width:0;

  padding:6px 12px;

  display:flex;
  align-items:center;
  justify-content:center;

  background:#f7f7f8 !important;

  border:2px solid #8d8d96 !important;
  border-radius:13px;

  box-shadow:
    inset 0 0 0 2px #fff,
    0 2px 3px rgba(0,0,0,.12);

  transform:none !important;

  overflow:hidden;
}


/* 로고 크기 */
.gacha-tab img{
  display:block;

  width:auto;
  height:auto;

  max-width:112px;
  max-height:34px;

  object-fit:contain;

  filter:none;
}


/* 기존 밑줄 활성화 완전히 제거 */
.gacha-tab::after,
.gacha-tab.active::after{
  display:none !important;
  content:none !important;
}


/* 마우스를 올렸을 때 */
.gacha-tab:hover{
  background:#e9fffc !important;
  border-color:#50cfc5 !important;

  box-shadow:
    inset 0 0 0 2px #fff,
    0 3px 7px rgba(56,190,181,.20);
}


/* 선택된 가챠:
   1回引く 버튼과 같은 방식 */
.gacha-tab.active{
  background:#4fd2c7 !important;
  border-color:#39aaa2 !important;

  box-shadow:
    inset 0 0 0 2px rgba(255,255,255,.85),
    0 3px 7px rgba(56,190,181,.20);
}


/* 선택되어도 로고 자체는 그대로 */
.gacha-tab.active img{
  opacity:1;
}


/* ----------------------------------
   SELECTED GACHA DESCRIPTION
---------------------------------- */

.banner{
  min-height:auto;

  margin:0 0 18px;
  padding:18px 22px;

  background:#f8f9fa;

  border:2px solid #dedee2;
  border-radius:13px;

  box-shadow:
    inset 0 0 0 2px #fff,
    0 2px 4px rgba(0,0,0,.08);
}


/* 웹사이트 느낌의 장식 제거 */
.banner::after{
  display:none;
}

.banner.collab{
  background:#f8f9fa;
}


/* ALL ACTOR / COLLABORATION */
.banner b{
  display:inline-block;

  padding:3px 12px;

  background:#ffad28;
  color:#fff;

  border-radius:999px;

  font-size:11px;
  font-weight:800;
  letter-spacing:.03em;

  text-shadow:
    0 1px 1px rgba(0,0,0,.12);
}


/* 메인 설명 */
.banner h2{
  margin:10px 0 0;

  color:#55545d;

  font-size:20px;
  font-weight:800;
  letter-spacing:.015em;

  text-shadow:
    0 1px 0 #fff;
}


/* ----------------------------------
   PULL BUTTONS
---------------------------------- */

.actions{
  gap:12px;
}


/* 유메스테 원본처럼:
   회색 외곽선 + 밝은 면 + 둥근 모서리 */
.actions button{
  min-width:170px;
  min-height:62px;

  padding:8px 18px;

  background:
    linear-gradient(#fff,#eeeeF1) !important;

  color:#55545d !important;

  border:2px solid #85858d !important;
  border-radius:14px;

  box-shadow:
    inset 0 0 0 2px rgba(255,255,255,.95),
    0 3px 4px rgba(0,0,0,.14);

  text-shadow:
    0 1px 0 #fff;

  transform:none;
}


/* 10회 버튼의 기존 primary 색 강제 제거 */
.actions .primary{
  background:
    linear-gradient(#fff,#eeeeF1) !important;

  color:#55545d !important;
}


/* 커서를 올린 경우에만 포인트색 */
.actions button:hover,
.actions .primary:hover{
  background:
    linear-gradient(#65ded5,#3fc8bd) !important;

  border-color:#329f98 !important;

  color:#fff !important;

  text-shadow:
    0 1px 2px rgba(0,0,0,.18);

  transform:translateY(-1px);

  box-shadow:
    inset 0 0 0 2px rgba(255,255,255,.75),
    0 4px 7px rgba(0,0,0,.14);
}


/* 뽑기 글씨 */
.pull-label{
  font-size:17px;
  font-weight:800;
  line-height:1.1;
}


/* 재화 */
.pull-cost{
  margin-top:5px;

  font-size:13px;
  font-weight:800;

  color:inherit;
  opacity:1;
}


/* 재화 이미지 */
.pull-cost img{
  width:19px;
  height:19px;

  object-fit:contain;
}


/* 결과 초기화는 살짝 작게 */
#clear{
  min-width:145px;
  font-size:14px;
}


/* ----------------------------------
   STATS
---------------------------------- */

.stats{
  margin:20px 0 17px;

  color:#8b8a91;

  font-size:13px;
  font-weight:700;

  border-bottom:1px solid #e7e7e9;
}

.stats b{
  color:#55545d;
  font-weight:800;
}


/* ----------------------------------
   RESULT CARDS
---------------------------------- */

.card{
  border:2px solid #dedee2;

  border-radius:12px;

  box-shadow:
    0 3px 8px rgba(0,0,0,.10);

  background:#fff;
}

.card:hover{
  transform:translateY(-2px);

  border-color:#6bd7ce;

  box-shadow:
    0 6px 14px rgba(0,0,0,.13);
}

.card .title{
  color:#4f4e57;

  font-weight:800;
}

.card .actor{
  color:#96959c;

  font-weight:700;
}


/* 별 등급 */
.card .stars,
#modalStars{
  color:#ff9f24;

  font-weight:800;

  text-shadow:
    0 1px 1px rgba(0,0,0,.08);
}


/* ----------------------------------
   EMPTY MESSAGE
---------------------------------- */

.empty{
  color:#aaa9b0;

  font-size:14px;
  font-weight:700;
}


/* ========================================
   START SCREEN
   ======================================== */

.start-screen{
  position:fixed;
  inset:0;
  z-index:9999;

  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;

  background:#fff;

  opacity:1;
  transition:
    opacity .35s ease,
    visibility .35s ease;
}

.start-screen[hidden]{
  display:none;
}

.start-button{
  width:150px;
  height:150px;

  display:flex;
  align-items:center;
  justify-content:center;

  padding:0;

  border:0;
  outline:0;

  background:transparent;

  cursor:pointer;

  appearance:none;
  -webkit-appearance:none;

  transition:transform .16s ease;
}

.start-button img{
  display:block;

  width:125px;
  height:125px;

  object-fit:contain;

  user-select:none;
  -webkit-user-drag:none;
}

.start-button:hover{
  transform:scale(1.04);
}

.start-button:active{
  transform:scale(.97);
}

.start-hint{
  margin-top:15px;

  font-family:"YumesteUI",
              "Hiragino Kaku Gothic ProN",
              sans-serif;

  font-size:11px;
  font-weight:700;

  letter-spacing:.18em;

  color:#c5c5ca;

  transition:
    color .16s ease,
    transform .16s ease;
}

.start-button:hover + .start-hint{
  color:#8f8f96;
  transform:translateY(2px);
}

.start-screen.start-leave{
  opacity:0;
  visibility:hidden;
}

/* 카드 정보: 배우명을 메인으로 강조 */

.card .info{
  padding:12px 13px 13px;
}

.card .stars{
  margin-bottom:7px;
}

.card .actor{
  margin:0;
  padding:0;

  color:#4d4c55;

  font-size:16px;
  font-weight:800;
  line-height:1.25;
}

.card .title{
  margin-top:5px;

  color:#8c8b93;

  font-size:12px;
  font-weight:700;
  line-height:1.4;

  /* 긴 카드명은 최대 두 줄 */
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
}

/* ===== ユメステ風 テキストエフェクト ===== */

/* 가챠 버튼의 1回引く / 10回引く */
.pull-label {
  font-weight: 900;
  letter-spacing: 0.02em;

  /* 밝은 테두리 + 아래쪽 입체 그림자 */
  -webkit-text-stroke: 1px rgba(255,255,255,0.95);
  paint-order: stroke fill;

  text-shadow:
    0 1px 0 rgba(255,255,255,0.95),
    0 2px 0 rgba(80,78,88,0.18),
    0 3px 5px rgba(60,58,68,0.14);
}


/* 배너 메인 문구 */
.banner h2 {
  font-weight: 900;
  letter-spacing: 0.015em;

  -webkit-text-stroke: 1px rgba(255,255,255,0.9);
  paint-order: stroke fill;

  text-shadow:
    0 1px 0 #fff,
    0 2px 0 rgba(80,78,88,0.13),
    0 3px 5px rgba(70,68,78,0.10);
}


/* 상단 메인 제목 */
main > h1 {
  font-weight: 900;
  letter-spacing: 0.015em;

  -webkit-text-stroke: 1px rgba(255,255,255,0.9);
  paint-order: stroke fill;

  text-shadow:
    0 2px 0 rgba(255,255,255,0.9),
    0 3px 0 rgba(75,73,84,0.12),
    0 4px 7px rgba(65,63,74,0.10);
}


/* 통계 숫자 */
.stats b {
  font-weight: 900;
  text-shadow:
    0 1px 0 #fff,
    0 2px 3px rgba(60,58,68,0.12);
}


/* 카드 액터명은 효과를 약하게 */
.card .actor {
  font-weight: 900;
  text-shadow:
    0 1px 0 #fff,
    0 1px 2px rgba(60,58,68,0.10);
}



/* ===== TITLE EASTER EGG ===== */

.title-row {
  display: flex;
  align-items: center;
  gap: 8px;
  position: relative;
}

.title-row > h1 {
  margin-right: 0;
}

/* 전체 이스터에그 영역 */
.easter-egg {
  position: relative;
  display: flex;
  align-items: center;
  height: 54px;
  z-index: 20;
}

/* 분홍 캐릭터: 항상 고정 */
.easter-trigger {
  position: relative;
  z-index: 3;

  width: 48px;
  height: 48px;
  padding: 0;

  border: 0;
  background: transparent;
  cursor: pointer;

  flex: 0 0 48px;

  transition:
    transform .18s ease,
    filter .18s ease;
}

.easter-trigger:hover {
  transform: translateY(-2px) scale(1.04);
  filter: drop-shadow(0 3px 4px rgba(0,0,0,.12));
}

.easter-left {
  display: block;
  width: 48px;
  height: 48px;
  object-fit: contain;
}

/*
  닫혀 있을 때:
  파란 캐릭터를 분홍 캐릭터 뒤에 겹쳐 숨겨둠.
*/
.easter-reveal {
  position: absolute;
  left: 0;
  top: 50%;

  height: 54px;
  width: 48px;

  transform: translateY(-50%);

  pointer-events: none;
}

/* 가운데 연락처 */
.easter-message {
  position: absolute;
  left: 58px;
  top: 50%;

  width: 0;
  padding: 0;

  transform: translateY(-50%);

  opacity: 0;
  overflow: hidden;
  white-space: nowrap;

  font-size: 11px;
  line-height: 1.45;
  color: #55525d;

  transition:
    width .45s cubic-bezier(.22,.8,.25,1),
    opacity .25s ease,
    padding .45s cubic-bezier(.22,.8,.25,1);
}

.easter-message strong,
.easter-message span {
  display: block;
}

.easter-message strong {
  font-size: 11.5px;
  color: #34313b;
  margin-bottom: 2px;
}

.easter-message a {
  color: inherit;
  font-weight: 800;
  text-decoration: none;
}

.easter-message a:hover {
  text-decoration: underline;
}

/* 파란 캐릭터 */
.easter-right {
  position: absolute;
  z-index: 2;

  left: 0;
  top: 3px;

  width: 48px;
  height: 48px;
  object-fit: contain;

  opacity: 0;

  transition:
    transform .52s cubic-bezier(.22,.8,.25,1),
    opacity .18s ease;
}


/* ===== 열렸을 때 ===== */

.easter-egg.open .easter-reveal {
  pointer-events: auto;
}

.easter-egg.open .easter-message {
  width: 330px;
  padding: 5px 8px;

  opacity: 1;
}

.easter-egg.open .easter-right {
  /*
    분홍이는 그대로,
    파란이만 연락처 오른쪽까지 슬라이드
  */
  transform: translateX(405px);
  opacity: 1;
}


/* 작은 화면에서 너무 길어지는 것 방지 */
@media (max-width: 760px) {
  .easter-egg.open .easter-message {
    width: 270px;
    white-space: normal;
  }

  .easter-egg.open .easter-right {
    transform: translateX(345px);
  }
}



/* ===== TITLE ALIGNMENT + HOME ===== */

.title-row {
  display: flex;
  align-items: center;
}

/* h1 자체의 기본 line-height 때문에 어긋나는 것 방지 */
.title-row > h1 {
  display: flex;
  align-items: center;
  margin-top: 0;
  margin-bottom: 0;
  line-height: 1;
}

/* 제목을 버튼처럼 보이지 않게 */
.title-home {
  appearance: none;
  -webkit-appearance: none;

  margin: 0;
  padding: 0;

  border: 0;
  background: transparent;

  color: inherit;
  font: inherit;
  font-weight: inherit;
  letter-spacing: inherit;
  line-height: 1;

  cursor: pointer;

  text-align: left;

  transition:
    opacity .18s ease,
    transform .18s ease;
}

.title-home:hover {
  opacity: .78;
}

.title-home:active {
  transform: translateY(1px);
}


/* 이스터에그를 제목의 정확한 세로 중앙에 */
.easter-egg {
  align-self: center;
  height: 48px;
  display: flex;
  align-items: center;
}

.easter-trigger {
  align-self: center;
}

.easter-left {
  display: block;
  margin: 0;
}

/* 파란 캐릭터도 같은 중앙선 */
.easter-reveal {
  top: 50%;
  height: 48px;
  transform: translateY(-50%);
}

.easter-right {
  top: 0;
}

.easter-message {
  top: 50%;
  transform: translateY(-50%);
}



/* ===== TITLE AREA SPACING FIX ===== */

/* 제목 + 이스터에그와 아래 가챠 로고 사이에 여유 */
.title-row {
  margin-bottom: 28px !important;
}

/* 제목과 이스터에그 자체 간격 */
.title-row {
  gap: 12px !important;
}



/* ===== 10 PULL GUARANTEE ===== */

.ten-pull-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.guarantee-badge {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 7px);
  transform: translateX(-50%);
  z-index: 5;

  padding: 5px 13px 6px;

  background: #e94b55;
  border: 2px solid #fff;
  border-radius: 8px;

  color: #fff;
  font-size: 13px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: .02em;
  white-space: nowrap;

  box-shadow:
    0 1px 0 rgba(70,60,70,.20),
    0 2px 5px rgba(70,60,70,.16);

  text-shadow: 0 1px 1px rgba(100,20,30,.25);

  pointer-events: none;
}

/* 흰색 테두리까지 있는 말풍선 꼬리 */
.guarantee-badge::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 100%;
  transform: translateX(-50%);

  border-left: 7px solid transparent;
  border-right: 7px solid transparent;
  border-top: 7px solid #fff;
}

.guarantee-badge::after {
  content: "";
  position: absolute;
  left: 50%;
  top: calc(100% - 2px);
  transform: translateX(-50%);

  border-left: 5px solid transparent;
  border-right: 5px solid transparent;
  border-top: 5px solid #e94b55;
}



/* ===== SAVE NOTICE ===== */

.save-notice {
  width: 100%;
  max-width: 980px;
  margin: 0 auto 28px;
  padding: 0 20px;

  text-align: center;

  color: #99959f;
  font-size: 11px;
  font-weight: 600;
  line-height: 1.6;
  letter-spacing: .01em;
}

/* ===== GIFT BOX UI ===== */

.gift-toolbar {
  display: flex;
  justify-content: flex-end;
  margin: -4px 0 14px;
}

.gift-box-button {
  position: relative;
  display: flex;
  align-items: center;
  gap: 7px;

  min-height: 42px;
  padding: 7px 14px;

  border: 2px solid #85858d;
  border-radius: 12px;

  background: linear-gradient(#ffffff, #eeeeF1);
  color: #55545d;

  font: inherit;
  font-size: 13px;
  font-weight: 800;

  cursor: pointer;

  box-shadow:
    inset 0 0 0 2px rgba(255,255,255,.95),
    0 2px 4px rgba(0,0,0,.12);
}

.gift-box-button:hover {
  background: linear-gradient(#65ded5, #3fc8bd);
  border-color: #329f98;
  color: white;
}

.gift-icon {
  font-size: 17px;
  line-height: 1;
}

.gift-badge {
  position: absolute;
  top: -9px;
  right: -9px;

  display: grid;
  place-items: center;

  min-width: 22px;
  height: 22px;
  padding: 0 5px;

  border: 2px solid white;
  border-radius: 999px;

  background: #e94b55;
  color: white;

  font-size: 11px;
  font-weight: 900;
  line-height: 1;

  box-shadow: 0 2px 5px rgba(0,0,0,.18);
}


/* ---------- modal ---------- */

.gift-modal {
  position: fixed;
  inset: 0;
  z-index: 10000;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 24px;

  background: rgba(25,25,30,.58);
}

.gift-modal[hidden] {
  display: none;
}

.gift-dialog {
  width: min(620px, calc(100vw - 32px));
  max-height: min(650px, calc(100vh - 48px));

  display: flex;
  flex-direction: column;

  overflow: hidden;

  border: 3px solid #85858d;
  border-radius: 18px;

  background: #f7f7f9;

  box-shadow:
    inset 0 0 0 2px white,
    0 14px 45px rgba(0,0,0,.25);
}


/* ---------- header ---------- */

.gift-header {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;

  min-height: 66px;
  padding: 14px 60px;

  border-bottom: 2px solid #dedee2;

  background: white;
}

.gift-header h2 {
  margin: 0;

  color: #55545d;

  font-size: 21px;
  font-weight: 900;
}

.gift-close {
  position: absolute;
  top: 50%;
  right: 14px;

  width: 38px;
  height: 38px;

  transform: translateY(-50%);

  border: 2px solid #85858d;
  border-radius: 50%;

  background: white;
  color: #66656d;

  font: inherit;
  font-size: 22px;

  cursor: pointer;
}


/* ---------- gifts ---------- */

.gift-list {
  min-height: 190px;
  padding: 14px;

  overflow-y: auto;
}

.gift-item {
  display: flex;
  align-items: center;
  gap: 14px;

  margin-bottom: 10px;
  padding: 14px 15px;

  border: 2px solid #dedee2;
  border-radius: 13px;

  background: white;

  box-shadow: 0 2px 4px rgba(0,0,0,.06);
}

.gift-item:last-child {
  margin-bottom: 0;
}

.gift-info {
  min-width: 0;
  flex: 1;

  display: flex;
  flex-direction: column;
  gap: 5px;

  color: #55545d;
}

.gift-info strong {
  font-size: 14px;
  font-weight: 900;
}

.gift-info span {
  color: #ff9f24;

  font-size: 16px;
  font-weight: 900;
}


/* ---------- buttons ---------- */

.gift-receive,
.gift-receive-all {
  border: 2px solid #329f98;
  border-radius: 12px;

  background: linear-gradient(#65ded5, #3fc8bd);
  color: white;

  font: inherit;
  font-weight: 900;

  cursor: pointer;

  box-shadow:
    inset 0 0 0 2px rgba(255,255,255,.5),
    0 2px 4px rgba(0,0,0,.12);
}

.gift-receive {
  min-width: 100px;
  min-height: 42px;

  padding: 7px 13px;
}

.gift-footer {
  display: flex;
  justify-content: center;

  padding: 14px;

  border-top: 2px solid #dedee2;

  background: white;
}

.gift-receive-all {
  min-width: 180px;
  min-height: 46px;

  padding: 8px 18px;

  font-size: 15px;
}


/* ---------- mobile ---------- */

@media (max-width: 600px) {

  .gift-modal {
    padding: 14px;
  }

  .gift-dialog {
    width: 100%;
    max-height: calc(100vh - 28px);
  }

  .gift-item {
    gap: 9px;
    padding: 11px;
  }

  .gift-info strong {
    font-size: 12px;
  }

  .gift-info span {
    font-size: 14px;
  }

  .gift-receive {
    min-width: 86px;
    font-size: 12px;
  }
}

/* ===== GIFT ICON BUTTON FIX ===== */

/*
  プレゼント 글자는 사용하지 않고
  직접 제작한 선물상자 그림만 표시
*/
.gift-box-button {
  width: 58px !important;
  height: 58px !important;
  min-width: 58px !important;
  min-height: 58px !important;

  padding: 5px !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  border-radius: 15px !important;

  overflow: visible !important;
}

.gift-box-button .gift-icon {
  display: block !important;

  width: 46px !important;
  height: 46px !important;

  object-fit: contain !important;

  font-size: 0 !important;
  line-height: 0 !important;

  pointer-events: none;
}


/* 빨간 미수령 배지 */
.gift-box-button .gift-badge {
  top: -8px !important;
  right: -8px !important;

  z-index: 2;
}


/* ===== GIFT CLOSE BUTTON CENTER FIX ===== */

.gift-close {
  box-sizing: border-box !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  width: 38px !important;
  height: 38px !important;

  padding: 0 0 3px 0 !important;
  margin: 0 !important;

  line-height: 1 !important;

  text-align: center !important;

  font-size: 24px !important;
  font-family: Arial, sans-serif !important;
  font-weight: 400 !important;
}




/* ===== CURRENCY UI ===== */

/* hidden 속성이 기존 gift-badge 스타일보다 항상 우선 */
#giftBadge[hidden] {
  display: none !important;
}

.gift-toolbar {
  align-items: center !important;
  gap: 12px !important;
}

.currency-display {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  min-width: 126px;
  height: 48px;
  padding: 4px 13px 4px 9px;

  box-sizing: border-box;

  border: 2px solid #85858d;
  border-radius: 14px;

  background: linear-gradient(#ffffff, #f0f0f3);

  color: #55545d;

  font-size: 16px;
  font-weight: 900;

  box-shadow:
    inset 0 0 0 2px rgba(255,255,255,.95),
    0 2px 4px rgba(0,0,0,.10);
}

.currency-display img {
  display: block;

  width: 32px;
  height: 32px;

  object-fit: contain;
}

#currencyBalance {
  min-width: 66px;
  text-align: right;

  font-variant-numeric: tabular-nums;
}


/* 재화 부족 팝업 */
.currency-alert {
  position: fixed;
  left: 50%;
  bottom: 36px;
  z-index: 12000;

  transform: translateX(-50%) translateY(15px);

  padding: 12px 22px;

  border: 2px solid #85858d;
  border-radius: 999px;

  background: rgba(255,255,255,.97);
  color: #55545d;

  font-size: 14px;
  font-weight: 900;

  box-shadow: 0 5px 18px rgba(0,0,0,.18);

  opacity: 0;
  pointer-events: none;

  transition:
    opacity .18s ease,
    transform .18s ease;
}

.currency-alert.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

@media (max-width: 600px) {
  .currency-display {
    min-width: 108px;
    height: 44px;
    padding-right: 10px;
  }

  .currency-display img {
    width: 29px;
    height: 29px;
  }

  #currencyBalance {
    min-width: 55px;
    font-size: 14px;
  }
}



/* ===== TOP TOOLBAR POSITION FIX ===== */

.gift-toolbar {
  width: 100% !important;

  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;

  gap: 12px !important;

  margin: 0 0 10px !important;
}


/* ---------- PRESENT ICON ---------- */

.gift-box-button {
  position: relative !important;

  width: 58px !important;
  height: 58px !important;
  min-width: 58px !important;
  min-height: 58px !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  padding: 0 !important;
  margin: 0 !important;

  border: 0 !important;
  outline: 0 !important;
  border-radius: 0 !important;

  background: transparent !important;

  box-shadow: none !important;

  overflow: visible !important;

  cursor: pointer;
}

.gift-box-button:hover,
.gift-box-button:focus,
.gift-box-button:active {
  border: 0 !important;
  outline: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
}

.gift-box-button .gift-icon {
  display: block !important;

  width: 56px !important;
  height: 56px !important;

  object-fit: contain !important;

  pointer-events: none;

  transition: transform .15s ease;
}

.gift-box-button:hover .gift-icon {
  transform: translateY(-2px) scale(1.04);
}

.gift-box-button:active .gift-icon {
  transform: scale(.96);
}


/* ---------- BADGE ---------- */

.gift-box-button .gift-badge {
  position: absolute !important;

  top: -4px !important;
  right: -7px !important;

  z-index: 5;
}

#giftBadge[hidden] {
  display: none !important;
}


/* ---------- CURRENCY ---------- */

.currency-display {
  margin-left: auto !important;
}


/* ---------- FONT ---------- */

html,
body,
button,
input,
select,
textarea {
  font-family:
    "YumesteUI",
    "Noto Sans JP",
    "Hiragino Sans",
    sans-serif !important;
}


@media (max-width: 600px) {

  .gift-toolbar {
    margin-bottom: 8px !important;
  }

  .gift-box-button {
    width: 52px !important;
    height: 52px !important;
    min-width: 52px !important;
    min-height: 52px !important;
  }

  .gift-box-button .gift-icon {
    width: 50px !important;
    height: 50px !important;
  }
}



/* ===== OWNED LIST + TOOLBAR ORDER ===== */


/* =====================================================
   TOP TOOLBAR

   왼쪽  : 선물함
   오른쪽: 보유 재화

   HTML에 어떤 순서로 들어 있어도
   order로 강제 배치한다.
===================================================== */

.gift-toolbar {
  display: flex !important;
  align-items: center !important;

  width: 100% !important;

  margin: 0 0 6px !important;
}


/* 선물함은 무조건 왼쪽 */
.gift-toolbar .gift-box-button {
  order: 1 !important;

  margin-left: 0 !important;
  margin-right: 0 !important;
}


/* 재화는 무조건 오른쪽 */
.gift-toolbar .currency-display {
  order: 2 !important;

  margin-left: auto !important;
  margin-right: 0 !important;
}


/* =====================================================
   PRESENT ICON

   일러스트 외의 버튼 장식 제거
===================================================== */

.gift-toolbar .gift-box-button {
  width: 58px !important;
  height: 58px !important;

  min-width: 58px !important;
  min-height: 58px !important;

  padding: 0 !important;

  border: none !important;
  outline: none !important;
  border-radius: 0 !important;

  background: none !important;
  background-color: transparent !important;
  background-image: none !important;

  box-shadow: none !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  overflow: visible !important;
}


.gift-toolbar .gift-box-button:hover,
.gift-toolbar .gift-box-button:focus,
.gift-toolbar .gift-box-button:active {
  border: none !important;

  background: none !important;

  box-shadow: none !important;
}


.gift-toolbar .gift-box-button .gift-icon {
  width: 56px !important;
  height: 56px !important;

  display: block !important;

  object-fit: contain !important;
}


/* 미수령 0 → 배지 없음 */
#giftBadge[hidden] {
  display: none !important;
}


/* =====================================================
   所持一覧
===================================================== */

.owned-list-row {
  width: 100%;

  display: flex;
  justify-content: flex-end;

  margin: 0 0 12px;
}


.owned-list-button {
  min-width: 116px;
  min-height: 40px;

  padding: 7px 17px;

  border: 2px solid #85858d;
  border-radius: 12px;

  background:
    linear-gradient(
      #ffffff,
      #eeeeF1
    );

  color: #55545d;

  font-family:
    "YumesteUI",
    "Noto Sans JP",
    "Hiragino Sans",
    sans-serif !important;

  font-size: 13px;
  font-weight: 800;

  cursor: pointer;

  box-shadow:
    inset 0 0 0 2px rgba(255,255,255,.95),
    0 2px 4px rgba(0,0,0,.10);

  transition:
    transform .15s ease,
    background .15s ease,
    border-color .15s ease;
}


.owned-list-button:hover {
  transform: translateY(-1px);

  border-color: #329f98;

  background:
    linear-gradient(
      #65ded5,
      #3fc8bd
    );

  color: white;
}


.owned-list-button:active {
  transform: translateY(1px);
}


/* =====================================================
   FONT
===================================================== */

html,
body,
button,
input,
select,
textarea {
  font-family:
    "YumesteUI",
    "Noto Sans JP",
    "Hiragino Sans",
    sans-serif !important;
}


@media (max-width: 600px) {

  .gift-toolbar .gift-box-button {
    width: 52px !important;
    height: 52px !important;

    min-width: 52px !important;
    min-height: 52px !important;
  }

  .gift-toolbar .gift-box-button .gift-icon {
    width: 50px !important;
    height: 50px !important;
  }

  .owned-list-button {
    min-width: 105px;
    min-height: 38px;

    font-size: 12px;
  }
}




/* ===== COMPACT GACHA MENU ===== */


/*
  PC:
  6개 가챠 + 所持一覧 + ミニゲーム
  총 8칸
*/

.gacha-tabs {
  display: grid !important;

  grid-template-columns:
    repeat(8, minmax(0, 1fr)) !important;

  gap: 9px !important;

  margin-bottom: 20px !important;
}


/* ─────────────────────────────
   가챠 로고 버튼 축소
───────────────────────────── */

.gacha-tabs .gacha-tab {
  width: 100% !important;

  height: 72px !important;

  min-width: 0 !important;

  padding: 8px 10px !important;

  border-radius: 8px !important;
}


.gacha-tabs .gacha-tab img {
  display: block !important;

  width: auto !important;
  height: auto !important;

  max-width: 92% !important;
  max-height: 48px !important;

  object-fit: contain !important;
}


/* 기존 active 밑줄도 작은 버튼에 맞춤 */
.gacha-tabs .gacha-tab.active::after {
  left: 10px !important;
  right: 10px !important;
}


/* =====================================================
   所持一覧 / ミニゲーム

   가챠 로고와 완전히 같은 크기
===================================================== */

.gacha-tabs .gacha-menu-button {
  width: 100% !important;
  height: 72px !important;

  min-width: 0 !important;
  min-height: 0 !important;

  margin: 0 !important;
  padding: 8px !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  border: 1px solid #e7e7eb !important;
  border-radius: 8px !important;

  background: #fff !important;

  color: #55545d !important;

  font-family:
    "YumesteUI",
    "Noto Sans JP",
    "Hiragino Sans",
    sans-serif !important;

  font-size: 14px !important;
  font-weight: 700 !important;

  line-height: 1.2 !important;

  box-shadow: none !important;

  cursor: pointer;

  transition:
    transform .18s ease,
    border-color .18s ease,
    box-shadow .18s ease,
    background .18s ease !important;
}


.gacha-tabs .gacha-menu-button:hover {
  transform: translateY(-2px) !important;

  border-color: #91e5dd !important;

  background: #fbffff !important;

  color: #55545d !important;

  box-shadow:
    0 8px 25px rgba(41,196,184,.10) !important;
}


/* 이전 所持一覧 CSS의 별도 row는 더 이상 사용 안 함 */
.owned-list-row {
  display: none !important;
}


/* =====================================================
   화면이 좁아질 경우
===================================================== */

@media (max-width: 900px) {

  .gacha-tabs {
    grid-template-columns:
      repeat(4, minmax(0, 1fr)) !important;

    gap: 8px !important;
  }

}


@media (max-width: 600px) {

  .gacha-tabs {
    grid-template-columns:
      repeat(2, minmax(0, 1fr)) !important;

    gap: 8px !important;
  }

  .gacha-tabs .gacha-tab,
  .gacha-tabs .gacha-menu-button {
    height: 68px !important;
  }

  .gacha-tabs .gacha-tab img {
    max-height: 44px !important;
  }

  .gacha-tabs .gacha-menu-button {
    font-size: 13px !important;
  }

}



/* ===== CLEAN HEADER UTILITY ROW ===== */


/*
   제목
   ↓
   🎁 -------------------------------- 💎
   ↓
   8개 메뉴
*/


.top-utility-row {
  width: 100%;

  display: grid;

  /*
    아래의 8칸 메뉴와 동일한 그리드.
    따라서 첫 칸과 마지막 칸 위치를
    정확하게 맞출 수 있다.
  */
  grid-template-columns:
    repeat(8, minmax(0, 1fr));

  gap: 9px;

  align-items: center;

  margin:
    8px
    0
    12px;

  padding: 0;
}


/* 선물함 = 첫 번째 칸 */
.top-utility-left {
  grid-column: 1;

  display: flex;
  align-items: center;
  justify-content: flex-start;
}


/* 재화 = 마지막 칸 */
.top-utility-right {
  grid-column: 8;

  display: flex;
  align-items: center;
  justify-content: center;
}


/* =====================================================
   선물함
===================================================== */

.top-utility-row .gift-box-button {
  position: relative;

  width: 58px !important;
  height: 58px !important;

  min-width: 58px !important;
  min-height: 58px !important;

  margin: 0 !important;
  padding: 0 !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  border: 0 !important;
  outline: 0 !important;
  border-radius: 0 !important;

  background: transparent !important;
  background-image: none !important;

  box-shadow: none !important;

  overflow: visible !important;

  cursor: pointer;
}


.top-utility-row .gift-box-button:hover,
.top-utility-row .gift-box-button:focus,
.top-utility-row .gift-box-button:active {
  border: 0 !important;
  outline: 0 !important;

  background: transparent !important;

  box-shadow: none !important;
}


.top-utility-row .gift-icon {
  display: block !important;

  width: 56px !important;
  height: 56px !important;

  object-fit: contain !important;

  pointer-events: none;

  transition: transform .15s ease;
}


.top-utility-row .gift-box-button:hover .gift-icon {
  transform: translateY(-2px) scale(1.04);
}


.top-utility-row .gift-box-button:active .gift-icon {
  transform: scale(.96);
}


.top-utility-row .gift-badge {
  position: absolute !important;

  top: -4px !important;
  right: -7px !important;

  z-index: 5;
}


#giftBadge[hidden] {
  display: none !important;
}


/* =====================================================
   재화

   기존 디자인은 그대로.
   위치만 8번째 칸.
===================================================== */

.top-utility-right .currency-display {
  margin: 0 !important;

  width: 100%;

  max-width: 136px;
}


/* =====================================================
   메뉴와의 간격
===================================================== */

.top-utility-row + .gacha-tabs {
  margin-top: 0 !important;
}


/* =====================================================
   PC
===================================================== */

@media (min-width: 901px) {

  /*
    선물함을 첫 번째 메뉴 박스의
    왼쪽 안쪽에 자연스럽게 배치.
  */
  .top-utility-left {
    padding-left: 8px;
  }

}


/* =====================================================
   태블릿
===================================================== */

@media (max-width: 900px) {

  .top-utility-row {
    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    gap: 8px;
  }

  .top-utility-left {
    grid-column: 1;
  }

  .top-utility-right {
    grid-column: 4;
  }

}


/* =====================================================
   모바일
===================================================== */

@media (max-width: 600px) {

  .top-utility-row {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 8px;

    margin-bottom: 10px;
  }

  .top-utility-left {
    grid-column: 1;
  }

  .top-utility-right {
    grid-column: 2;
  }

  .top-utility-row .gift-box-button {
    width: 52px !important;
    height: 52px !important;

    min-width: 52px !important;
    min-height: 52px !important;
  }

  .top-utility-row .gift-icon {
    width: 50px !important;
    height: 50px !important;
  }

}



/* ===== GIFT VERTICAL CENTER FIX ===== */

/*
  제목 ↕ 로고 사이 빈 공간의 중앙으로
  선물함만 이동.
  재화 위치는 건드리지 않음.
*/

.top-utility-left .gift-box-button {
  transform: translateY(-17px) !important;
}

.top-utility-left .gift-box-button:hover {
  transform: translateY(-19px) !important;
}

.top-utility-left .gift-box-button:active {
  transform: translateY(-17px) scale(.96) !important;
}



/* ===== OWNED LIST SCREEN UI ===== */


/* hidden은 기존 display 규칙보다 우선 */
#gachaScreen[hidden],
#ownedScreen[hidden] {
  display: none !important;
}


.owned-screen {
  width: 100%;

  padding-top: 6px;
}


/* ---------- HEADER ---------- */

.owned-screen-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 20px;

  padding-bottom: 16px;

  border-bottom: 1px solid #e8e8ec;
}


.owned-screen-label {
  margin: 0 0 5px;

  color: #aaa;

  font-size: 10px;
  letter-spacing: 1.8px;
}


.owned-screen-header h2 {
  margin: 0;

  color: #44434b;

  font-size: 28px;
  line-height: 1;
}


.owned-back-button {
  min-height: 40px;

  padding: 8px 18px;

  border: 2px solid #85858d;
  border-radius: 11px;

  background:
    linear-gradient(
      #fff,
      #eeeeF1
    );

  color: #55545d;

  font-size: 13px;
  font-weight: 800;

  cursor: pointer;
}


/* ---------- SUMMARY ---------- */

.owned-summary {
  display: flex;

  gap: 10px;

  margin-bottom: 16px;
}


.owned-summary-item {
  min-width: 150px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 11px 15px;

  border: 1px solid #e4e4e8;
  border-radius: 10px;

  background: #fafafa;

  color: #777;

  font-size: 12px;
}


.owned-summary-item strong {
  color: #44434b;

  font-size: 15px;
}


/* ---------- FILTER ---------- */

.owned-filters {
  display: flex;

  gap: 7px;

  margin-bottom: 18px;
}


.owned-filter {
  min-width: 76px;

  padding: 8px 13px;

  border: 1px solid #dddde2;
  border-radius: 999px;

  background: #fff;

  color: #777;

  font-size: 12px;
  font-weight: 800;

  cursor: pointer;
}


.owned-filter:hover {
  border-color: #70dcd3;
}


.owned-filter.active {
  border-color: #48d7ca;

  background: #48d7ca;

  color: #fff;
}


/* ---------- CARD GRID ---------- */

.owned-results {
  display: grid;

  grid-template-columns:
    repeat(5, minmax(0, 1fr));

  gap: 14px;

  align-items: stretch;
}


.owned-card {
  position: relative;

  min-width: 0;

  padding: 0;

  overflow: hidden;

  display: flex;
  flex-direction: column;

  border: 1px solid #ececf0;
  border-radius: 13px;

  background: #fff;

  text-align: left;

  cursor: pointer;

  box-shadow:
    0 3px 12px rgba(0,0,0,.06);

  transition:
    transform .15s ease,
    box-shadow .15s ease;
}


.owned-card:hover {
  transform: translateY(-2px);

  box-shadow:
    0 7px 18px rgba(0,0,0,.10);
}


.owned-card > img {
  display: block;

  width: 100%;

  aspect-ratio: 16 / 9;

  object-fit: cover;
}


/* ---------- DUPLICATE COUNT ---------- */

.owned-card-count {
  position: absolute;

  top: 7px;
  right: 7px;

  min-width: 32px;

  padding: 4px 7px;

  border: 2px solid rgba(255,255,255,.9);
  border-radius: 999px;

  background: rgba(48,48,55,.82);

  color: #fff;

  font-size: 11px;
  font-weight: 900;

  line-height: 1;

  text-align: center;

  box-shadow:
    0 2px 5px rgba(0,0,0,.18);
}


/* ---------- CARD INFO ---------- */

.owned-card-info {
  flex: 1;

  display: flex;
  flex-direction: column;

  padding: 10px 11px 12px;
}


.owned-card-stars {
  color: #55545d;

  font-size: 12px;

  letter-spacing: 1px;
}


.owned-card-actor {
  margin-top: 5px;

  color: #999;

  font-size: 10px;
}


.owned-card-title {
  margin-top: 4px;

  color: #44434b;

  font-size: 12px;
  font-weight: 800;

  line-height: 1.35;
}


/* ---------- EMPTY ---------- */

.owned-empty {
  grid-column: 1 / -1;

  padding: 80px 20px;

  color: #aaa;

  text-align: center;

  font-size: 13px;
}


/* ---------- RESPONSIVE ---------- */

@media (max-width: 900px) {

  .owned-results {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }

}


@media (max-width: 600px) {

  .owned-screen-header {
    align-items: center;
  }

  .owned-screen-header h2 {
    font-size: 23px;
  }

  .owned-back-button {
    padding: 7px 12px;

    font-size: 11px;
  }

  .owned-summary {
    display: grid;

    grid-template-columns: 1fr 1fr;
  }

  .owned-summary-item {
    min-width: 0;

    gap: 8px;

    padding: 9px 10px;

    font-size: 10px;
  }

  .owned-summary-item strong {
    font-size: 12px;
  }

  .owned-filters {
    overflow-x: auto;

    padding-bottom: 3px;
  }

  .owned-filter {
    flex: 0 0 auto;
  }

  .owned-results {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 9px;
  }

}




/* ===== OWNED TAB ACTIVE FINAL ===== */

/*
  所持一覧도 가챠 로고 선택 상태와
  동일한 민트색 active 표현
*/

.gacha-tabs .gacha-menu-button.active {
  position: relative !important;

  border-color: #48d7ca !important;

  background: #fbffff !important;

  color: #44434b !important;

  box-shadow:
    0 0 0 2px rgba(72,215,202,.12),
    0 7px 22px rgba(72,215,202,.10) !important;
}


.gacha-tabs .gacha-menu-button.active::after {
  content: "";

  position: absolute;

  left: 10px;
  right: 10px;
  bottom: -1px;

  height: 3px;

  border-radius: 3px 3px 0 0;

  background: #48d7ca;
}


/* 所持種類 하나만 남으므로 작게 */
.owned-summary {
  display: flex !important;
}


.owned-summary-item {
  min-width: 190px !important;
}


/* 戻る 버튼이 없으므로 헤더 단순화 */
.owned-screen-header {
  display: block !important;
}


/* ===== OWNED ACTIVE MINT FILL ===== */
.gacha-tabs #ownedListButton.active {
  background: #48d7ca !important;
  border-color: #48d7ca !important;
  color: #fff !important;
  box-shadow: none !important;
}

.gacha-tabs #ownedListButton.active::after {
  display: none !important;
}


/* ===== OWNED MISSING SWITCH UI ===== */

.owned-summary {
  display: flex !important;
  align-items: center !important;
  gap: 8px !important;
  flex-wrap: wrap;
}


.owned-view-switch {
  display: flex;
  gap: 6px;
}


.owned-view-button {
  height: 39px;

  padding: 0 16px;

  border: 1px solid #dddde2;
  border-radius: 10px;

  background: #fff;

  color: #777;

  font-size: 12px;
  font-weight: 800;

  cursor: pointer;

  transition:
    background .15s ease,
    border-color .15s ease,
    color .15s ease;
}


.owned-view-button:hover {
  border-color: #48d7ca;
}


.owned-view-button.active {
  background: #48d7ca;
  border-color: #48d7ca;

  color: #fff;
}


/* 미소지 카드 */
#ownedResults .owned-card.is-missing {
  opacity: .58;
}


#ownedResults .owned-card.is-missing .owned-card-count {
  display: none;
}


/* ===== MISSING CARD OPACITY FINAL ===== */

/*
  未所持フォト 모드에서는 카드 전체를 확실하게 흐리게.
  기존 개별 is-missing 클래스 여부와 무관하게 적용.
*/
#ownedResults.showing-missing .owned-card {
  opacity: .48 !important;
}


/* hover해도 투명도가 다시 올라가지 않도록 */
#ownedResults.showing-missing .owned-card:hover {
  opacity: .48 !important;
}


/* 미소지에는 ×0 같은 보유 수 표시 없음 */
#ownedResults.showing-missing .owned-card-count {
  display: none !important;
}



/* ===== RARITY ORDER BUTTON UI ===== */

.owned-rank-order-button {
  margin-left: auto;

  min-width: 112px;

  padding: 8px 13px;

  border: 1px solid #dddde2;
  border-radius: 999px;

  background: #fff;

  color: #666;

  font-size: 11px;
  font-weight: 800;

  cursor: pointer;

  transition:
    border-color .15s ease,
    background .15s ease;
}


.owned-rank-order-button:hover {
  border-color: #48d7ca;

  background: #f5fffe;
}

